---
const links = [
  { text: "ฟีเจอร์", href: "#features" },
  { text: "ราคา", href: "#pricing" },
  { text: "รีวิว", href: "#testimonials" },
  { text: "FAQ", href: "#faq" },
];
---

<header class="fixed w-full top-0 z-50 bg-[var(--brand-surface)]/90 backdrop-blur-sm border-b border-gray-100 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-[var(--brand-primary)] flex items-center justify-center text-white font-bold text-xl group-hover:scale-105 transition-transform">
            P
        </div>
        <span class="text-2xl font-bold text-[var(--brand-primary)]">POS<span class="text-[var(--brand-text)]">Pro</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8">
        {links.map(link => (
          <a href={link.href} class="text-[var(--brand-text-muted)] hover:text-[var(--brand-primary)] transition-colors font-medium">
            {link.text}
          </a>
        ))}
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center space-x-4">
        <a href="#demo" class="text-[var(--brand-text-muted)] hover:text-[var(--brand-primary)] font-medium">เข้าสู่ระบบ</a>
        <a href="#trial" class="bg-[var(--brand-primary)] text-white px-5 py-2 rounded-lg hover:bg-[var(--brand-secondary)] transition-colors font-medium shadow-lg shadow-[var(--brand-primary)]/20">
          ทดลองใช้ฟรี 14 วัน
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-[var(--brand-text-muted)] hover:text-[var(--brand-text)] focus:outline-none">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[var(--brand-surface)] border-t border-gray-100 absolute w-full left-0">
    <div class="px-4 pt-2 pb-6 space-y-1 shadow-xl">
      {links.map(link => (
        <a href={link.href} class="block py-2 text-base font-medium text-[var(--brand-text-muted)] hover:text-[var(--brand-primary)] hover:bg-gray-50 rounded-md">
          {link.text}
        </a>
      ))}
      <div class="pt-4 mt-4 border-t border-gray-100 flex flex-col gap-3">
        <a href="#demo" class="block w-full text-center py-2 text-[var(--brand-text-muted)] font-medium">เข้าสู่ระบบ</a>
        <a href="#trial" class="block w-full text-center py-3 bg-[var(--brand-primary)] text-white rounded-lg font-medium">
          ทดลองใช้ฟรี
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>

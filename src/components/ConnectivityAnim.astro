---
<div class="connectivity-anim relative w-full h-full min-h-[160px] flex items-center justify-center overflow-hidden rounded-lg bg-slate-50 border border-slate-200">
    
    <!-- Sources (Left Side) -->
    <div class="absolute left-4 top-1/2 -translate-y-1/2 flex flex-col gap-8">
        <!-- Facebook Source -->
        <div class="relative group">
            <div class="w-10 h-10 bg-[#1877F2] rounded-full flex items-center justify-center text-white text-lg shadow-md z-10 relative">
                f
            </div>
            <!-- Ghost Bubble FB -->
            <div class="chat-bubble-fb absolute left-10 top-0 bg-white border border-slate-200 px-3 py-1.5 rounded-xl rounded-tl-none shadow-sm text-[10px] text-slate-600 w-24 opacity-0">
                CF 1 set krub
            </div>
        </div>

        <!-- WhatsApp Source -->
        <div class="relative group">
            <div class="w-10 h-10 bg-[#25D366] rounded-full flex items-center justify-center text-white text-lg shadow-md z-10 relative">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
             <!-- Ghost Bubble WA -->
            <div class="chat-bubble-wa absolute left-10 top-0 bg-white border border-slate-200 px-3 py-1.5 rounded-xl rounded-tl-none shadow-sm text-[10px] text-slate-600 w-24 opacity-0">
                Slip attached 💸
            </div>
        </div>
    </div>

    <!-- Destination (Right/Center) -->
    <div class="absolute right-4 top-1/2 -translate-y-1/2 w-48 bg-white rounded-lg border border-slate-200 shadow-sm p-3 z-0">
        <div class="text-[10px] font-bold text-slate-400 mb-2 uppercase tracking-wider">Recent Orders</div>
        <div class="space-y-2 relative">
            <!-- Static Existing Orders -->
            <div class="flex items-center gap-2 p-1.5 bg-slate-50 rounded border border-slate-100 opacity-50">
                <div class="w-6 h-6 bg-slate-200 rounded-full flex items-center justify-center text-[10px]">👤</div>
                <div class="h-2 w-16 bg-slate-200 rounded"></div>
            </div>
            
            <!-- Dynamic Incoming Order 1 (FB) -->
            <div class="order-row-fb flex items-center gap-2 p-1.5 bg-blue-50 rounded border border-blue-100 opacity-0 transform translate-x-4">
                <div class="w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center text-[8px] font-bold shadow-sm">FB</div>
                <div class="flex-1">
                    <div class="h-2 w-20 bg-blue-200 rounded mb-1"></div>
                </div>
            </div>

            <!-- Dynamic Incoming Order 2 (WA) -->
             <div class="order-row-wa flex items-center gap-2 p-1.5 bg-green-50 rounded border border-green-100 opacity-0 transform translate-x-4">
                <div class="w-6 h-6 bg-green-500 text-white rounded-full flex items-center justify-center text-[8px] font-bold shadow-sm">WA</div>
                <div class="flex-1">
                    <div class="h-2 w-16 bg-green-200 rounded mb-1"></div>
                </div>
            </div>

        </div>
    </div>

</div>

<style>
    /* Facebook Flow */
    .chat-bubble-fb {
        animation: flowFb 4s infinite;
    }
    .order-row-fb {
        animation: popupFb 4s infinite;
    }

    /* WhatsApp Flow (Delayed) */
    .chat-bubble-wa {
        animation: flowWa 4s infinite 2s; /* Start halfway through FB cycle */
    }
    .order-row-wa {
        animation: popupWa 4s infinite 2s;
    }

    /* Keyframes */
    @keyframes flowFb {
        0% { opacity: 0; transform: translate(0, 0) scale(0.8); }
        10% { opacity: 1; transform: translate(0, 0) scale(1); }
        40% { opacity: 1; transform: translate(60px, 0px) scale(1); } /* Move right */
        50% { opacity: 0; transform: translate(80px, 0px) scale(0.5); } /* Vanish into destination */
        100% { opacity: 0; transform: translate(80px, 0px) scale(0.5); }
    }

    @keyframes popupFb {
        0%, 45% { opacity: 0; transform: translateX(10px); height: 0; margin: 0; padding: 0; border: none; }
        50% { opacity: 1; transform: translateX(0); height: auto; margin: theme('spacing.2') 0; padding: 0.375rem; border-width: 1px; }
        90% { opacity: 1; }
        100% { opacity: 0; } /* Fade out to reset loop */
    }

    @keyframes flowWa {
        0% { opacity: 0; transform: translate(0, 0) scale(0.8); }
        10% { opacity: 1; transform: translate(0, 0) scale(1); }
        40% { opacity: 1; transform: translate(60px, -20px) scale(1); } /* Move right & up slightly towards list center */
        50% { opacity: 0; transform: translate(80px, -20px) scale(0.5); }
        100% { opacity: 0; transform: translate(80px, -20px) scale(0.5); }
    }

    @keyframes popupWa {
        0%, 45% { opacity: 0; transform: translateX(10px); height: 0; margin: 0; padding: 0; border: none; }
        50% { opacity: 1; transform: translateX(0); height: auto; margin: theme('spacing.2') 0; padding: 0.375rem; border-width: 1px; }
        90% { opacity: 1; }
        100% { opacity: 0; }
    }

    /* Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
        .chat-bubble-fb, .chat-bubble-wa, .order-row-fb, .order-row-wa {
            animation: none;
            opacity: 1;
            transform: none;
            transition: opacity 0.5s;
        }
        /* Show static state */
        .chat-bubble-fb { opacity: 1; }
        .chat-bubble-wa { opacity: 1; }
        .order-row-fb { opacity: 1; }
        .order-row-wa { opacity: 1; }
    }
</style>

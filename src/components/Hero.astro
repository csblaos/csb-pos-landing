---
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden bg-[var(--brand-background)] transition-colors duration-300">
  <!-- Background Decoration -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-[var(--brand-primary)]/10 rounded-full blur-3xl mix-blend-multiply"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-[var(--brand-accent)]/10 rounded-full blur-3xl mix-blend-multiply"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center px-4 py-2 rounded-full bg-[var(--brand-surface)] text-[var(--brand-primary)] text-sm font-medium mb-8 border border-[var(--brand-primary)]/20 shadow-sm animate-fade-in-up">
      <span class="flex h-2 w-2 rounded-full bg-[var(--brand-primary)] mr-2 animate-pulse"></span>
      สำหรับร้านค้าออนไลน์ Facebook, LINE, Website
    </div>
    
    <!-- Headline -->
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--brand-text)] leading-tight mb-6">
      รวมทุกออเดอร์ออนไลน์ไว้ที่เดียว <br class="hidden md:block" />
      <span class="text-[var(--brand-primary)]">
        ไม่พลาดสักแชต สต็อกแม่นยำ
      </span>
    </h1>
    
    <!-- Subheadline -->
    <p class="text-lg md:text-xl text-[var(--brand-text-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
      ระบบจัดการร้านค้าออนไลน์ที่ช่วยให้คุณรวมแชตจากทุกช่องทาง ตัดสต็อก Real-time 
      และสรุปยอดขายอัตโนมัติ ให้คุณมีเวลาโฟกัสกับการขายได้เต็มที่
    </p>
    
    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-16">
      <a href="#trial" class="w-full sm:w-auto px-8 py-4 bg-[var(--brand-primary)] text-white rounded-xl font-bold text-lg hover:bg-[var(--brand-secondary)] transition-all shadow-xl shadow-[var(--brand-primary)]/30 transform hover:-translate-y-1">
        ทดลองใช้ฟรี 14 วัน
      </a>
      <a href="#demo" class="w-full sm:w-auto px-8 py-4 bg-[var(--brand-surface)] text-[var(--brand-text)] border border-gray-200 rounded-xl font-bold text-lg hover:bg-gray-50 transition-colors">
        นัดเดโมดูระบบ
      </a>
    </div>

    <!-- Hero Image / Dashboard Preview -->
    <div class="relative mx-auto max-w-5xl group">
       <div class="rounded-2xl border border-[var(--brand-primary)]/10 bg-[var(--brand-surface)] p-2 shadow-2xl transition-all duration-500 hover:shadow-[var(--brand-primary)]/20">
        <div class="rounded-xl bg-gray-50 aspect-[16/9] flex items-center justify-center overflow-hidden relative">
             <!-- Abstract UI Representation -->
             <div class="w-full h-full flex flex-col p-4 md:p-8 bg-gradient-to-br from-white to-gray-50">
                <!-- Mock Header -->
                <div class="h-8 w-full flex justify-between items-center mb-6 border-b border-gray-100 pb-2">
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                        <div class="w-3 h-3 rounded-full bg-green-400"></div>
                    </div>
                    <div class="w-1/3 h-2 bg-gray-100 rounded-full"></div>
                </div>
                <!-- Mock Content -->
                <div class="flex-1 flex gap-4">
                    <!-- Sidebar -->
                    <div class="w-1/4 h-full hidden md:flex flex-col gap-3">
                        <div class="h-8 bg-[var(--brand-primary)]/10 rounded w-full"></div>
                        <div class="h-8 bg-white border border-gray-100 rounded w-full"></div>
                        <div class="h-8 bg-white border border-gray-100 rounded w-full"></div>
                        <div class="h-8 bg-white border border-gray-100 rounded w-full"></div>
                    </div>
                    <!-- Main Area -->
                    <div class="flex-1 flex flex-col gap-4">
                        <div class="grid grid-cols-3 gap-4">
                            <div class="h-20 bg-white shadow-sm border border-gray-100 rounded-lg p-3">
                                <div class="w-8 h-8 rounded bg-blue-100 mb-2"></div>
                                <div class="w-12 h-2 bg-gray-200 rounded"></div>
                            </div>
                            <div class="h-20 bg-white shadow-sm border border-gray-100 rounded-lg p-3">
                                <div class="w-8 h-8 rounded bg-green-100 mb-2"></div>
                                <div class="w-12 h-2 bg-gray-200 rounded"></div>
                            </div>
                            <div class="h-20 bg-white shadow-sm border border-gray-100 rounded-lg p-3">
                                <div class="w-8 h-8 rounded bg-purple-100 mb-2"></div>
                                <div class="w-12 h-2 bg-gray-200 rounded"></div>
                            </div>
                        </div>
                        <div class="flex-1 bg-white shadow-sm border border-gray-100 rounded-lg p-4">
                            <div class="w-full h-4 bg-gray-100 rounded mb-3"></div>
                            <div class="w-full h-4 bg-gray-100 rounded mb-3"></div>
                            <div class="w-full h-4 bg-gray-100 rounded mb-3"></div>
                            <div class="w-3/4 h-4 bg-gray-100 rounded"></div>
                        </div>
                    </div>
                </div>
             </div>
             
             <!-- Floating Elements (Notifications) -->
             <div class="absolute top-1/4 right-10 bg-white p-3 rounded-lg shadow-lg border-l-4 border-green-500 animate-bounce flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold">✓</div>
                <div>
                    <p class="text-xs font-bold text-gray-900">ออเดอร์ใหม่ +5</p>
                    <p class="text-xs text-gray-500">จาก Facebook</p>
                </div>
             </div>
        </div>
      </div>
    </div>
  </div>
</section>

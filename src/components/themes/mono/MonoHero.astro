---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';

const { hero } = content;
---

<section id="mono-hero" class="relative min-h-screen flex items-center pt-24 bg-white text-black overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid lg:grid-cols-2 gap-24 items-center">
        <div class="space-y-12">
            <!-- Minimal Indicator -->
            <div class="flex items-center gap-4">
                <span class="h-px w-12 bg-black"></span>
                <span class="text-xs tracking-[0.3em] uppercase font-medium">Collection 015</span>
            </div>

            <h1 class="text-6xl md:text-8xl font-serif text-black leading-[1.1] tracking-tight">
                {hero.title_part1} <br/>
                <span class="italic font-light text-neutral-500">{hero.title_part2}</span>
            </h1>

            <p class="text-lg text-neutral-600 font-light leading-relaxed max-w-sm border-l border-black pl-8">
                {hero.subtitle}
            </p>

            <div class="flex flex-col sm:flex-row gap-8 pt-8">
                <button class="group flex items-center gap-4 text-sm tracking-[0.2em] uppercase font-medium hover:gap-6 transition-all">
                    <span class="border-b border-black pb-1">{hero.primaryCta}</span>
                    <span class="text-xl">→</span>
                </button>
                <button class="text-sm tracking-[0.2em] uppercase text-neutral-400 hover:text-black transition-colors flex items-center gap-2">
                    {hero.secondaryCta}
                    <span class="text-lg">+</span>
                </button>
            </div>
        </div>

        <div class="relative hidden lg:block h-[600px] w-full bg-neutral-100">
            <div class="absolute inset-0 grayscale contrast-125 opacity-50 mix-blend-multiply bg-[url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-1.2.1&auto=format&fit=crop&w=1000&q=80')] bg-cover bg-center"></div>
            
            <div class="absolute bottom-12 left-12 bg-white p-8 max-w-xs shadow-2xl">
                 <div class="text-4xl font-serif mb-2">98<span class="text-lg align-top">%</span></div>
                 <div class="text-[10px] tracking-[0.2em] uppercase text-neutral-500">Client Satisfaction Index</div>
                 
                 <div class="mt-8 border-t border-black pt-4">
                     <HeroToast />
                 </div>
            </div>
        </div>
    </div>
</section>

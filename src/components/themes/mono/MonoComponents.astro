---
import { content } from '../../../data/content';

const { features, pricing, painPoints, solutions, socialProof, faq, finalCta } = content;
---

<!-- Pain & Solutions -->
<section class="py-32 bg-white font-theme">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-24">
        <div>
            <h2 class="text-4xl font-serif mb-12">The Contrast</h2>
            <div class="space-y-12">
                {painPoints.map((pain, i) => (
                    <div class="group">
                        <span class="text-[10px] block mb-2 text-neutral-300">0{i+1}</span>
                        <p class="text-xl font-light text-neutral-400 group-hover:text-black transition-colors duration-500">{pain}</p>
                    </div>
                ))}
            </div>
        </div>
        <div class="pt-24 md:pt-48">
             <div class="space-y-12">
                {solutions.map((sol, i) => (
                    <div class="group text-right">
                        <span class="text-[10px] block mb-2 text-neutral-300">0{i+1}</span>
                        <p class="text-xl font-medium text-black">{sol}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section id="mono-features" class="py-32 bg-neutral-50 font-theme">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-200 border-t border-b border-neutral-200">
            {features.map((feature, i) => (
                <div class="p-12 group hover:bg-white transition-colors duration-500">
                    <div class="text-3xl mb-8 opacity-20 group-hover:opacity-100 transition-opacity duration-500">
                        <svg viewBox="0 0 24 24" class="w-8 h-8" fill="currentColor" set:html={feature.icon}></svg>
                    </div>
                    <h3 class="text-lg font-serif italic mb-4">{feature.title}</h3>
                    <p class="text-sm font-light text-neutral-500 leading-loose">{feature.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Pricing -->
<section id="mono-pricing" class="py-32 bg-black text-white font-theme">
    <div class="max-w-7xl mx-auto px-6">
         <div class="text-center mb-24">
            <h2 class="text-5xl font-serif italic">Investment</h2>
        </div>
        
        <div class="grid md:grid-cols-3 border-t border-neutral-800">
            {pricing.plans.map((plan, i) => (
                <div class={`p-12 border-b border-neutral-800 md:border-b-0 ${i !== 2 ? 'md:border-r' : ''} group hover:bg-neutral-900 transition-colors duration-500`}>
                    <div class="flex justify-between items-start mb-16">
                        <h3 class="text-sm tracking-[0.2em] uppercase">{plan.name}</h3>
                        {plan.recommended && <span class="w-2 h-2 bg-white rounded-full"></span>}
                    </div>
                    
                    <div class="text-5xl font-serif mb-12">{plan.price}</div>
                    
                    <ul class="space-y-6 mb-16">
                        {plan.features.map(feature => (
                            <li class="flex gap-4 text-sm font-light text-neutral-400 group-hover:text-white transition-colors">
                                <span>—</span> {feature}
                            </li>
                        ))}
                    </ul>

                    <button class="w-full py-4 text-xs tracking-[0.2em] uppercase border border-neutral-800 hover:bg-white hover:text-black transition-colors">
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Testimonials -->
<section id="mono-testimonials" class="py-32 bg-white font-theme">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="grid md:grid-cols-2 gap-16">
            {socialProof.testimonials.slice(0,2).map(t => (
                <div>
                    <p class="text-2xl font-serif italic leading-relaxed mb-8">"{t.quote}"</p>
                    <p class="text-xs tracking-[0.2em] uppercase text-neutral-400">{t.name}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- FAQ & Footer -->
<section id="mono-faq" class="py-32 bg-neutral-50 font-theme">
    <div class="max-w-2xl mx-auto px-6 mb-32">
        <h2 class="text-3xl font-serif mb-16 text-center">Discourse</h2>
        <div class="space-y-8">
            {faq.map(item => (
                <div class="group cursor-pointer">
                    <h3 class="text-lg font-medium mb-2 group-hover:italic transition-all">{item.q}</h3>
                    <p class="text-sm font-light text-neutral-500 leading-loose h-0 opacity-0 group-hover:h-auto group-hover:opacity-100 transition-all duration-500 overflow-hidden">
                        {item.a}
                    </p>
                    <div class="h-px w-full bg-neutral-200 mt-8 group-hover:bg-black transition-colors"></div>
                </div>
            ))}
        </div>
    </div>

    <div class="text-center max-w-xl mx-auto px-6">
        <h2 class="text-5xl font-serif mb-12">{finalCta.title}</h2>
        <button class="bg-black text-white px-12 py-5 text-sm tracking-[0.2em] uppercase hover:bg-neutral-800 transition-colors">
            {finalCta.primaryCta}
        </button>
    </div>
</section>

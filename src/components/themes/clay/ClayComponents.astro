---
import { content } from '../../../data/content';

const { features, pricing, painPoints, solutions, socialProof, faq, finalCta } = content;
---

<!-- Pain & Solutions -->
<section class="py-32 bg-[#eef2f6] font-theme">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-16">
        <div class="p-10 rounded-[40px] bg-[#eef2f6] shadow-[inset_10px_10px_20px_#cad4e0,inset_-10px_-10px_20px_#ffffff]">
            <h2 class="text-3xl font-extrabold text-slate-700 mb-8">Hard Problems.</h2>
            <div class="space-y-6">
                 {painPoints.map((pain) => (
                    <div class="flex items-start gap-4 p-4 rounded-2xl transition-all hover:bg-red-50/50">
                        <div class="w-8 h-8 rounded-full bg-[#eef2f6] shadow-[5px_5px_10px_#cad4e0,-5px_-5px_10px_#ffffff] flex items-center justify-center text-red-400 font-bold shrink-0">
                            !
                        </div>
                        <p class="text-slate-500 font-bold pt-1">{pain}</p>
                    </div>
                 ))}
            </div>
        </div>

        <div class="p-10 rounded-[40px] bg-[#eef2f6] shadow-[20px_20px_60px_#cad4e0,-20px_-20px_60px_#ffffff]">
            <h2 class="text-3xl font-extrabold text-slate-700 mb-8">Soft Solutions.</h2>
             <div class="space-y-6">
                 {solutions.map((sol) => (
                    <div class="flex items-start gap-4 p-4 rounded-2xl transition-all hover:bg-blue-50/50">
                        <div class="w-8 h-8 rounded-full bg-[#60a5fa] shadow-[inset_2px_2px_5px_rgba(0,0,0,0.2)] flex items-center justify-center text-white font-bold shrink-0">
                            ✓
                        </div>
                        <p class="text-slate-600 font-bold pt-1">{sol}</p>
                    </div>
                 ))}
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section id="clay-features" class="py-32 bg-[#eef2f6] font-theme">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
            <span class="px-6 py-2 rounded-full bg-[#eef2f6] shadow-[5px_5px_10px_#cad4e0,-5px_-5px_10px_#ffffff] text-slate-400 font-bold uppercase tracking-widest text-xs">
                Features
            </span>
            <h2 class="text-4xl font-extrabold text-slate-700 mt-8">Smooth Operations</h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-12">
            {features.map((feature, i) => (
                <div class="p-8 rounded-[40px] bg-[#eef2f6] shadow-[20px_20px_60px_#cad4e0,-20px_-20px_60px_#ffffff] hover:shadow-[30px_30px_70px_#cad4e0,-30px_-30px_70px_#ffffff] hover:-translate-y-2 transition-all duration-300 group">
                    <div class="w-16 h-16 rounded-[20px] bg-[#eef2f6] shadow-[inset_5px_5px_10px_#cad4e0,inset_-5px_-5px_10px_#ffffff] flex items-center justify-center text-3xl mb-8 text-blue-400 group-hover:text-red-400 transition-colors">
                        <svg viewBox="0 0 24 24" class="w-8 h-8" fill="currentColor" set:html={feature.icon}></svg>
                    </div>
                    <h3 class="text-xl font-extrabold text-slate-700 mb-4">{feature.title}</h3>
                    <p class="text-slate-500 font-medium leading-relaxed">{feature.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Pricing -->
<section id="clay-pricing" class="py-32 bg-[#eef2f6] font-theme">
    <div class="max-w-7xl mx-auto px-6">
         <div class="text-center mb-20">
            <h2 class="text-4xl font-extrabold text-slate-700">Comfortable Pricing</h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 items-start">
            {pricing.plans.map(plan => (
                <div class={`p-10 rounded-[50px] bg-[#eef2f6] transition-transform duration-300 ${
                    plan.recommended 
                    ? 'shadow-[inset_10px_10px_20px_#cad4e0,inset_-10px_-10px_20px_#ffffff] scale-105 z-10' 
                    : 'shadow-[20px_20px_60px_#cad4e0,-20px_-20px_60px_#ffffff]'
                }`}>
                    {plan.recommended && (
                        <div class="mb-8 w-fit mx-auto px-6 py-2 rounded-full bg-red-400 text-white text-xs font-extrabold uppercase shadow-lg shadow-red-200">
                            Recommended
                        </div>
                    )}
                    
                    <h3 class="text-2xl font-extrabold text-slate-700 mb-2 text-center">{plan.name}</h3>
                    <div class="text-4xl font-black text-slate-700 mb-8 text-center">{plan.price}</div>
                    
                    <ul class="space-y-4 mb-10">
                        {plan.features.map(feature => (
                            <li class="flex items-center gap-3 text-slate-500 font-bold text-sm">
                                <div class="w-2 h-2 rounded-full bg-blue-400"></div>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-4 rounded-[20px] font-extrabold uppercase tracking-wide transition-all active:scale-95 ${
                        plan.recommended 
                        ? 'bg-red-400 text-white shadow-[#f87171] hover:bg-red-500 shadow-xl' 
                        : 'bg-[#eef2f6] text-slate-500 shadow-[5px_5px_10px_#cad4e0,-5px_-5px_10px_#ffffff] hover:text-red-400'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Testimonials -->
<section id="clay-testimonials" class="py-32 bg-[#eef2f6] font-theme">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-12">
            {socialProof.testimonials.map((t, i) => (
                <div class="p-8 rounded-[40px] bg-[#eef2f6] shadow-[20px_20px_60px_#cad4e0,-20px_-20px_60px_#ffffff]">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 rounded-full bg-[#eef2f6] shadow-[inset_3px_3px_6px_#cad4e0,inset_-3px_-3px_6px_#ffffff] flex items-center justify-center text-slate-400 font-black">
                            {t.name[0]}
                        </div>
                        <div>
                            <p class="font-extrabold text-slate-700">{t.name}</p>
                            <p class="text-xs font-bold text-blue-400">VERIFIED</p>
                        </div>
                    </div>
                    <p class="text-slate-500 leading-relaxed font-medium">"{t.quote}"</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- FAQ & Footer -->
<section id="clay-faq" class="py-32 bg-[#eef2f6] font-theme">
    <div class="max-w-3xl mx-auto px-6 mb-24 space-y-8">
        <h2 class="text-3xl font-extrabold text-slate-700 text-center mb-12">Questions?</h2>
        {faq.map(item => (
            <details class="group p-6 rounded-[30px] bg-[#eef2f6] shadow-[10px_10px_20px_#cad4e0,-10px_-10px_20px_#ffffff] open:shadow-[inset_5px_5px_10px_#cad4e0,inset_-5px_-5px_10px_#ffffff] transition-all">
                <summary class="flex justify-between items-center cursor-pointer list-none font-bold text-slate-700">
                    <span>{item.q}</span>
                    <span class="w-8 h-8 rounded-full bg-[#eef2f6] shadow-[5px_5px_10px_#cad4e0,-5px_-5px_10px_#ffffff] flex items-center justify-center text-slate-400 group-open:rotate-180 transition-transform">↓</span>
                </summary>
                <div class="pt-6 text-slate-500 font-medium leading-relaxed">
                    {item.a}
                </div>
            </details>
        ))}
    </div>

    <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="p-16 rounded-[60px] bg-[#eef2f6] shadow-[inset_20px_20px_60px_#cad4e0,inset_-20px_-20px_60px_#ffffff]">
            <h2 class="text-4xl font-extrabold text-slate-700 mb-8">{finalCta.title}</h2>
            <button class="px-12 py-5 rounded-[25px] bg-[#eef2f6] text-red-500 font-black uppercase tracking-widest shadow-[10px_10px_20px_#cad4e0,-10px_-10px_20px_#ffffff] hover:shadow-[0_0_0_transparent] hover:translate-y-1 transition-all">
                {finalCta.primaryCta}
            </button>
        </div>
    </div>
</section>

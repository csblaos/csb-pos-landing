---
import ZenHero from './ZenHero.astro';
import ZenComponents from './ZenComponents.astro';
---

<div class="font-inter bg-white min-h-screen text-neutral-900">
    <!-- Zen Nav -->
    <nav class="fixed top-0 w-full z-40 bg-white/90 backdrop-blur-sm border-b border-neutral-100 transition-all duration-500">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <div class="text-sm font-medium tracking-[0.2em] text-neutral-900 uppercase">
                ZenPOS
            </div>

            <div class="hidden md:flex gap-12 text-[11px] font-medium uppercase tracking-[0.15em] text-neutral-500">
                <a href="#zen-features" class="hover:text-neutral-900 transition-colors">Features</a>
                <a href="#zen-pricing" class="hover:text-neutral-900 transition-colors">Price</a>
                <a href="#zen-testimonials" class="hover:text-neutral-900 transition-colors">Stories</a>
            </div>

            <button class="text-[11px] font-medium uppercase tracking-[0.15em] border border-neutral-200 px-6 py-2 hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition-all">
                Login
            </button>
        </div>
    </nav>

    <ZenHero />
    <ZenComponents />

    <footer class="bg-white py-12 text-center border-t border-neutral-100/50">
        <div class="text-[10px] uppercase tracking-[0.3em] text-neutral-300">
            Minimalism • Function • Clarity
        </div>
    </footer>
</div>

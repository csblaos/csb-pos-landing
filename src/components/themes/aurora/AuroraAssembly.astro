---
import AuroraHero from './AuroraHero.astro';
import AuroraComponents from './AuroraComponents.astro';
---

<div class="font-outfit bg-black min-h-screen text-white selection:bg-fuchsia-500 selection:text-white">
    <!-- Aurora Nav -->
    <nav class="fixed top-0 w-full z-40 transition-all duration-300">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-lg border-b border-white/10"></div>
        
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center relative z-10">
            <a href="#" class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-violet-400 to-fuchsia-400 hover:opacity-80 transition-opacity">
                Aurora_
            </a>

            <div class="hidden md:flex gap-8 text-sm font-medium text-white/70">
                <a href="#aurora-features" class="hover:text-white hover:shadow-[0_0_20px_white] transition-all">Features</a>
                <a href="#aurora-pricing" class="hover:text-white hover:shadow-[0_0_20px_white] transition-all">Pricing</a>
                <a href="#aurora-testimonials" class="hover:text-white hover:shadow-[0_0_20px_white] transition-all">Community</a>
            </div>

            <button class="px-6 py-2 rounded-full bg-white/10 border border-white/10 text-sm font-bold text-white hover:bg-white hover:text-black transition-all">
                Access
            </button>
        </div>
    </nav>

    <AuroraHero />
    <AuroraComponents />

    <footer class="bg-black py-12 text-center text-white/30 border-t border-white/5">
        <p class="text-xs tracking-widest uppercase">Designed for the next era</p>
    </footer>
</div>

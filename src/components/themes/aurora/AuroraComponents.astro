---
import { content } from '../../../data/content';

const { features, pricing, painPoints, solutions, socialProof, faq, finalCta } = content;
---

<!-- Pain & Solutions -->
<section class="py-32 bg-black font-theme relative">
    <!-- Ambient Light -->
    <div class="absolute top-[20%] left-0 w-[500px] h-[500px] bg-blue-900/20 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-16 relative z-10">
        <div>
            <h2 class="text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-red-400 to-orange-400 mb-12">The Chaos.</h2>
            <div class="space-y-6">
                {painPoints.map((pain) => (
                    <div class="p-6 rounded-2xl bg-white/5 border border-red-500/10 backdrop-blur-sm hover:bg-white/10 transition-colors">
                        <p class="text-white/80 font-medium">{pain}</p>
                    </div>
                ))}
            </div>
        </div>
        <div>
            <h2 class="text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-emerald-400 to-cyan-400 mb-12">The Clarity.</h2>
             <div class="space-y-6">
                {solutions.map((sol) => (
                    <div class="p-6 rounded-2xl bg-white/5 border border-emerald-500/10 backdrop-blur-sm hover:bg-white/10 transition-colors flex items-center gap-4">
                        <div class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.5)]"></div>
                        <p class="text-white font-medium">{sol}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section id="aurora-features" class="py-32 bg-[#050505] font-theme relative overflow-hidden">
     <!-- Ambient Light -->
    <div class="absolute bottom-0 right-0 w-[800px] h-[800px] bg-violet-900/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <h2 class="text-5xl font-bold text-center text-white mb-24 tracking-tight">Capabilities</h2>
        
        <div class="grid md:grid-cols-3 gap-8">
            {features.map((feature, i) => (
                <div class="group relative rounded-3xl bg-white/5 border border-white/10 p-8 backdrop-blur-md overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:bg-white/10">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-violet-500 via-fuchsia-500 to-cyan-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                    
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500/20 to-fuchsia-500/20 flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform duration-500">
                        <svg viewBox="0 0 24 24" class="w-8 h-8" fill="currentColor" set:html={feature.icon}></svg>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-4 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-violet-400 group-hover:to-fuchsia-400 transition-all">
                        {feature.title}
                    </h3>
                    <p class="text-white/60 leading-relaxed font-medium">
                        {feature.description}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Pricing -->
<section id="aurora-pricing" class="py-32 bg-black font-theme relative">
    <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-24">
            <h2 class="text-5xl font-bold text-white mb-6">Invest in Future</h2>
            <p class="text-white/40 text-lg">Transparent. Scalable. Powerful.</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 items-start">
            {pricing.plans.map(plan => (
                <div class={`relative p-8 rounded-3xl border backdrop-blur-md transition-all duration-500 ${
                    plan.recommended 
                    ? 'bg-white/10 border-violet-500/50 shadow-[0_0_50px_rgba(139,92,246,0.15)] md:-mt-8 md:mb-8' 
                    : 'bg-white/5 border-white/10 hover:bg-white/10'
                }`}>
                    {plan.recommended && (
                        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-lg">
                            RECOMMENDED
                        </div>
                    )}
                    
                    <h3 class="text-2xl font-bold text-white mb-2">{plan.name}</h3>
                    <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-white/60 mb-8">{plan.price}</div>
                    
                    <ul class="space-y-4 mb-10">
                        {plan.features.map(feature => (
                            <li class="flex items-center gap-3 text-white/70">
                                <div class={`w-1.5 h-1.5 rounded-full ${plan.recommended ? 'bg-fuchsia-500' : 'bg-white/30'}`}></div>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-4 rounded-xl text-sm font-bold tracking-wide transition-all ${
                        plan.recommended 
                        ? 'bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white hover:shadow-[0_0_30px_rgba(192,38,211,0.4)]' 
                        : 'bg-white/10 text-white hover:bg-white/20'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Testimonials -->
<section id="aurora-testimonials" class="py-32 bg-[#050505] font-theme border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h2 class="text-sm font-bold tracking-[0.3em] uppercase text-violet-400 mb-16">Transmissions</h2>
        <div class="grid md:grid-cols-3 gap-8">
            {socialProof.testimonials.map((t, i) => (
                <div class="p-8 rounded-3xl bg-gradient-to-b from-white/10 to-transparent border border-white/5 backdrop-blur-sm relative">
                    <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 rounded-full p-[2px] bg-gradient-to-br from-violet-500 to-fuchsia-500">
                        <div class="w-full h-full rounded-full bg-black flex items-center justify-center text-white font-bold">
                            {t.name[0]}
                        </div>
                    </div>
                    <p class="text-white/80 mt-6 mb-6 leading-relaxed">"{t.quote}"</p>
                    <p class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-400 font-bold">{t.name}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- FAQ & Footer -->
<section id="aurora-faq" class="py-32 bg-black font-theme relative overflow-hidden">
     <div class="absolute inset-0 bg-gradient-to-b from-transparent to-violet-900/20 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-6 mb-32 relative z-10">
        <h2 class="text-3xl font-bold text-center text-white mb-16">Frequently Asked</h2>
        <div class="space-y-4">
            {faq.map(item => (
                <details class="group bg-white/5 border border-white/10 rounded-2xl open:bg-white/10 transition-colors">
                    <summary class="flex justify-between items-center cursor-pointer p-6 font-medium text-white/90">
                        <span>{item.q}</span>
                        <span class="text-white/50 group-open:rotate-45 transition-transform">+</span>
                    </summary>
                    <div class="p-6 pt-0 text-white/60 leading-relaxed">
                        {item.a}
                    </div>
                </details>
            ))}
        </div>
    </div>

    <div class="relative z-10 text-center max-w-4xl mx-auto px-6">
        <div class="p-12 rounded-[3rem] bg-gradient-to-br from-violet-900/50 to-fuchsia-900/50 border border-white/10 backdrop-blur-xl">
             <h2 class="text-4xl md:text-6xl font-bold text-white mb-8">{finalCta.title}</h2>
             <button class="px-12 py-5 bg-white text-black rounded-full font-bold text-lg hover:scale-105 transition-transform shadow-[0_0_50px_rgba(255,255,255,0.3)]">
                {finalCta.primaryCta}
             </button>
        </div>
    </div>
</section>

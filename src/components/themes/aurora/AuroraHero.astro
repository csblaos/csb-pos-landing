---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';

const { hero } = content;
---

<section id="aurora-hero" class="relative min-h-screen flex items-center pt-20 bg-black overflow-hidden selection:bg-violet-500 selection:text-white">
    <!-- Animated Gradient Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] bg-violet-600/30 rounded-full blur-[120px] animate-drift"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-fuchsia-600/30 rounded-full blur-[120px] animate-drift delay-2000"></div>
        <div class="absolute top-[20%] right-[20%] w-[30%] h-[30%] bg-cyan-500/20 rounded-full blur-[100px] animate-drift delay-4000"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
        <div class="flex flex-col items-center text-center space-y-12">
            
            <!-- Glass Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-full backdrop-blur-md shadow-xl animate-fade-in-up">
                <span class="w-2 h-2 rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-500"></span>
                <span class="text-xs uppercase tracking-widest text-white/80 font-medium">Next Gen Architecture</span>
            </div>

            <!-- Headline -->
            <h1 class="text-5xl md:text-8xl font-bold tracking-tight text-white leading-tight animate-fade-in-up delay-100">
                <span class="bg-clip-text text-transparent bg-gradient-to-br from-white via-white to-white/50">{hero.title_part1}</span>
                <br/>
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-violet-400 via-fuchsia-400 to-cyan-400 pb-2">{hero.title_part2}</span>
            </h1>

            <!-- Subheadline -->
            <p class="text-lg md:text-xl text-white/60 font-medium max-w-2xl mx-auto leading-relaxed animate-fade-in-up delay-200">
                {hero.subtitle}
            </p>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in-up delay-300">
                <button class="group relative px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/10 rounded-2xl backdrop-blur-md transition-all shadow-[0_0_30px_rgba(139,92,246,0.2)] hover:shadow-[0_0_50px_rgba(139,92,246,0.4)] overflow-hidden flex items-center justify-center gap-3">
                    <div class="absolute inset-0 bg-gradient-to-r from-violet-600/50 to-fuchsia-600/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <svg class="w-5 h-5 relative z-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span class="relative z-10 text-white font-bold tracking-wide">{hero.primaryCta}</span>
                </button>
                <button class="px-8 py-4 text-white/80 hover:text-white font-medium tracking-wide transition-colors flex items-center gap-2">
                    {hero.secondaryCta}
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Floating Cards Decorative -->
    <div class="absolute top-1/2 left-10 hidden lg:block -translate-y-1/2 animate-float">
        <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center rotate-[-12deg]">
            <span class="text-2xl">⚡️</span>
        </div>
    </div>
    <div class="absolute top-1/2 right-10 hidden lg:block -translate-y-1/2 animate-float delay-1000">
        <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-md flex items-center justify-center rotate-[12deg]">
             <span class="text-2xl">💎</span>
        </div>
    </div>

    <div class="absolute bottom-12 right-6">
        <HeroToast />
    </div>
</section>

<style>
    @keyframes drift {
        0% { transform: translate(0, 0); }
        50% { transform: translate(30px, -30px); }
        100% { transform: translate(0, 0); }
    }
    .animate-drift {
        animation: drift 10s ease-in-out infinite;
    }
    .delay-2000 { animation-delay: 2s; }
    .delay-4000 { animation-delay: 4s; }

    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out forwards;
        opacity: 0;
        transform: translateY(30px);
    }
    .delay-100 { animation-delay: 0.1s; }
    .delay-200 { animation-delay: 0.2s; }
    .delay-300 { animation-delay: 0.3s; }

    @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

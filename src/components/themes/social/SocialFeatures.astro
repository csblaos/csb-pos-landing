---
import { content } from '../../../data/content';

const { features } = content;
---

<section class="py-24 bg-[#431407] font-theme overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <h2 class="text-4xl md:text-5xl font-extrabold text-[#fff7ed] mb-4 text-center">
            ฟีเจอร์เด็ด <span class="text-[#f97316]">มัดใจลูกค้า</span>
        </h2>
    </div>

    <!-- Horizontal Scrolling Container -->
    <div class="flex overflow-x-auto pb-12 gap-6 px-4 md:px-0 md:justify-center snap-x snap-mandatory no-scrollbar">
        {features.map((feature, index) => (
            <div class="min-w-[280px] md:min-w-[320px] bg-[#fff7ed] p-8 rounded-3xl snap-center transform hover:-translate-y-2 transition-all duration-300 border-b-8 border-[#ea580c] relative group">
                <div class="absolute -right-4 -top-4 w-16 h-16 bg-[#ffedd5] rounded-full flex items-center justify-center text-3xl font-black text-[#ea580c] group-hover:scale-125 transition-transform">
                    {index + 1}
                </div>
                <h3 class="text-2xl font-bold text-[#431407] mb-4 mt-2">{feature.title}</h3>
                <p class="text-[#7c2d12] font-medium leading-relaxed">
                    {feature.description}
                </p>
            </div>
        ))}
    </div>
</section>

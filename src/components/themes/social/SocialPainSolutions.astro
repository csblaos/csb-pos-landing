---
import { content } from '../../../data/content';

const { painPoints, solutions, comparison } = content;
---

<section class="py-24 bg-[#fff7ed] font-theme overflow-hidden">
    <!-- Pain: Breaking bubbles -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-32 relative">
        <h2 class="text-4xl md:text-5xl font-black text-center text-[#431407] mb-16 transform -rotate-1">
            😡 พอกันที! <span class="bg-[#ea580c] text-white px-2">ปัญหาเดิมๆ</span>
        </h2>
        
        <div class="flex flex-wrap justify-center gap-6">
            {painPoints.map((pain, index) => (
                <div class={`bg-white p-6 rounded-3xl border-2 border-[#fed7aa] shadow-[8px_8px_0px_0px_rgba(253,186,116,0.5)] transform hover:scale-110 transition-transform cursor-cell ${index % 2 === 0 ? 'rotate-2' : '-rotate-2'}`}>
                    <span class="text-4xl mb-2 block">💢</span>
                    <p class="text-[#7c2d12] font-bold text-lg">{pain}</p>
                </div>
            ))}
        </div>
    </div>

    <!-- Comparison: VS Mode -->
    <div class="bg-[#431407] py-24 transform -skew-y-3">
        <div class="transform skew-y-3 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
             <h2 class="text-4xl font-black text-center text-white mb-16">
                วัดกันชัดๆ <span class="text-[#ea580c]">VS</span>
            </h2>

            <div class="grid md:grid-cols-2 gap-8 items-center">
                <!-- Old Way -->
                <div class="bg-red-900/50 p-8 rounded-3xl border border-red-800 opacity-75 grayscale hover:grayscale-0 transition-all">
                    <h3 class="text-2xl font-black text-red-200 mb-6 text-center">❌ {comparison.oldWay.title}</h3>
                    <ul class="space-y-4">
                        {comparison.oldWay.points.map(pt => (
                            <li class="flex items-center text-red-100 font-bold">
                                <span class="mr-4 text-2xl">😩</span> {pt}
                            </li>
                        ))}
                    </ul>
                </div>

                <!-- New Way -->
                <div class="bg-white p-8 rounded-3xl border-4 border-[#ea580c] shadow-[0_0_40px_rgba(234,88,12,0.4)] relative">
                    <div class="absolute -top-6 -right-6 bg-[#ea580c] text-white font-black px-6 py-2 rounded-full rotate-12 shadow-lg">
                        WINNER! 🏆
                    </div>
                    <h3 class="text-3xl font-black text-[#431407] mb-6 text-center">✅ {comparison.newWay.title}</h3>
                     <ul class="space-y-4">
                        {comparison.newWay.points.map(pt => (
                            <li class="flex items-center text-[#431407] font-bold text-xl">
                                <span class="mr-4 text-2xl">🚀</span> {pt}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

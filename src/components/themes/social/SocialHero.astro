---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';
import ConnectivityAnim from '../../ConnectivityAnim.astro';

const { hero } = content;
---

<section class="min-h-[90vh] flex items-center bg-[#fff7ed] font-theme overflow-hidden relative">
    
    <!-- Background Decor (Circles) -->
    <div class="absolute -top-20 -left-20 w-96 h-96 bg-orange-200/40 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
    <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-red-200/40 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            
            <!-- Content: Centered on Mobile, Left on Desktop -->
            <div class="lg:w-1/2 text-center lg:text-left">
                <div class="inline-block bg-orange-100 text-orange-800 px-4 py-2 rounded-lg font-bold text-sm mb-6 transform -rotate-2 border-2 border-orange-200 shadow-[4px_4px_0px_0px_rgba(251,146,60,0.4)]">
                    🔥 {hero.badge}
                </div>
                
                <h1 class="text-4xl lg:text-7xl font-extrabold text-[#431407] leading-[0.9] tracking-tight mb-8 drop-shadow-sm">
                    รวมทุก <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-red-600">ออเดอร์ออนไลน์</span> <br/>
                    ไว้ที่เดียว
                </h1>

                <p class="text-lg lg:text-xl text-[#7c2d12] mb-10 leading-relaxed font-medium">
                    {hero.subtitle}
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <button class="px-6 py-4 bg-[#ea580c] text-white text-lg font-bold rounded-xl shadow-[0_10px_20px_rgba(234,88,12,0.3)] hover:shadow-[0_15px_30px_rgba(234,88,12,0.4)] hover:-translate-y-1 transition-all">
                        {hero.primaryCta} 🚀
                    </button>
                    <button class="px-6 py-4 bg-white text-[#431407] text-lg font-bold rounded-xl border-2 border-[#fed7aa] hover:bg-[#fff7ed] hover:border-[#ea580c] transition-all">
                        {hero.secondaryCta}
                    </button>
                </div>

                <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-sm font-bold text-[#9a3412]">
                   {hero.highlights.map(item => (
                       <span class="flex items-center">
                           <span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span>
                           {item}
                       </span>
                   ))}
                </div>
            </div>

            <!-- Visual: Floating Cards / Chaotically Organized -->
            <div class="lg:w-1/2 relative h-[500px] w-full hidden md:block">
                <!-- Main Phone / Dashboard Mockup -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 bg-white rounded-[2.5rem] border-[8px] border-orange-100 shadow-2xl p-4 rotate-3 z-10 transition-transform hover:rotate-0 duration-500">
                    <div class="bg-gray-100 h-full rounded-[1.5rem] overflow-hidden relative">
                         <div class="bg-[#ea580c] h-32 w-full rounded-b-[2rem] absolute top-0"></div>
                         <div class="absolute top-20 left-4 right-4 bg-white rounded-xl p-4 shadow-lg">
                             <div class="flex justify-between items-center mb-2">
                                 <span class="text-xs font-bold text-gray-500">ยอดขายวันนี้</span>
                                 <span class="text-green-500 text-xs font-bold">+25%</span>
                             </div>
                             <div class="text-3xl font-extrabold text-[#431407]">฿12,500</div>
                         </div>
                         <!-- Order List (Animated) -->
                         <div class="absolute top-52 left-4 right-4 h-40">
                             <ConnectivityAnim />
                         </div>
                    </div>
                </div>

                <!-- Floating Bubbles (Animated) -->
                <div class="absolute top-10 right-10 bg-white p-4 rounded-2xl rounded-tr-none shadow-xl shadow-orange-900/10 animate-float z-20 border border-orange-100 transform rotate-6">
                    <div class="text-sm font-bold text-[#431407]">👋 มีของพร้อมส่งไหมคะ?</div>
                    <div class="text-[10px] text-gray-400 mt-1">Facebook • 2m ago</div>
                </div>

                <div class="absolute bottom-20 left-0 bg-white p-4 rounded-2xl rounded-bl-none shadow-xl shadow-orange-900/10 animate-float animation-delay-1000 z-20 border border-orange-100 transform -rotate-3">
                    <div class="text-sm font-bold text-[#431407]">🚚 ขอเลขพัสดุหน่อยครับ</div>
                    <div class="text-[10px] text-gray-400 mt-1">LINE OA • 5m ago</div>
                </div>

                <div class="absolute top-40 -left-4 bg-[#431407] text-white px-4 py-2 rounded-full shadow-lg z-0 transform -rotate-12">
                    <span class="text-2xl">📦</span> Stock -1
                </div>

                <div class="absolute bottom-40 -right-4 bg-green-500 text-white px-4 py-2 rounded-full shadow-lg z-0 transform rotate-12">
                     💰 ฿490
                </div>

            </div>
        </div>
    </div>
    <!-- Toast (Top Right) -->
    <HeroToast />
</section>

---
import { content } from '../../../data/content';

const { pricing } = content;
---

<section class="py-24 bg-[#fff7ed] font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <div class="inline-block bg-[#fed7aa] text-[#7c2d12] px-4 py-1 rounded-full text-sm font-bold mb-4 transform rotate-2">
                🏷️ {pricing.note}
            </div>
            <h2 class="text-4xl font-extrabold text-[#431407]">เลือกแพ็กเกจที่ชอบ</h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-6 items-end">
            {pricing.plans.map(plan => (
                <div class={`relative p-8 rounded-3xl border-4 transition-transform hover:-translate-y-2 ${
                    plan.recommended 
                    ? 'bg-[#431407] border-[#ea580c] text-white scale-105 z-10 shadow-2xl' 
                    : 'bg-white border-[#fed7aa] text-[#431407]'
                }`}>
                    
                    {plan.recommended && (
                        <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-[#ea580c] text-white px-6 py-2 rounded-full font-bold shadow-lg animate-bounce">
                            ขายดีที่สุด! 🔥
                        </div>
                    )}

                    <h3 class={`text-2xl font-black mb-2 ${plan.recommended ? 'text-[#fb923c]' : 'text-[#431407]'}`}>{plan.name}</h3>
                    <p class={`text-sm mb-6 ${plan.recommended ? 'text-gray-300' : 'text-gray-500'}`}>{plan.description}</p>
                    
                    <div class="text-4xl font-black mb-8">{plan.price}</div>

                    <ul class="space-y-3 mb-8">
                        {plan.features.map(feature => (
                            <li class="flex items-center font-bold">
                                <span class={`w-6 h-6 rounded-full flex items-center justify-center mr-3 text-sm ${
                                    plan.recommended ? 'bg-[#ea580c] text-white' : 'bg-[#ffedd5] text-[#ea580c]'
                                }`}>✓</span>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-4 rounded-xl font-black text-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] active:shadow-none active:translate-y-1 transition-all ${
                        plan.recommended 
                        ? 'bg-[#ea580c] text-white hover:bg-[#fb923c]' 
                        : 'bg-[#ffedd5] text-[#9a3412] hover:bg-[#fed7aa]'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

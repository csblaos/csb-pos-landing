---
import SocialHero from './SocialHero.astro';
import SocialFeatures from './SocialFeatures.astro';
import SocialPricing from './SocialPricing.astro';
import SocialPainSolutions from './SocialPainSolutions.astro';
import SocialFooterCTA from './SocialFooterCTA.astro';
---

<div class="font-sarabun bg-[#fff7ed] min-h-screen text-[#431407]">
    <!-- Navbar: Floating & Rounded -->
    <nav class="fixed top-4 left-4 right-4 z-40 max-w-7xl mx-auto">
        <div class="bg-white/90 backdrop-blur-md rounded-full px-6 py-3 border border-orange-100 shadow-xl flex items-center justify-between">
            <div class="font-black text-xl text-[#ea580c] italic">
                SaaS POS <span class="text-xs ml-1 bg-orange-100 px-2 py-0.5 rounded-full not-italic">Boost!</span>
            </div>
            
            <button class="bg-[#431407] text-white px-6 py-2 rounded-full font-bold hover:bg-[#ea580c] transition-colors shadow-lg">
                เข้าสู่ระบบ
            </button>
        </div>
    </nav>

    <!-- Content -->
    <div class="pt-24">
        <SocialHero />
        <SocialPainSolutions />
        <SocialFeatures />
        <SocialPricing />
        <SocialFooterCTA />
    </div>

    <footer class="bg-[#431407] text-[#fed7aa] py-12 text-center font-bold">
        <p>Built for Speed. Built for Sales. &copy; 2024</p>
    </footer>
</div>

---
import CorporateHero from './CorporateHero.astro';
import CorporateComponents from './CorporateComponents.astro';
---

<div class="font-lato bg-white min-h-screen text-slate-900">
    <!-- Corporate Nav -->
    <nav class="fixed top-0 w-full z-40 bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <div class="text-2xl font-bold text-blue-900 tracking-tight flex items-center gap-2">
                <div class="w-6 h-6 bg-blue-900 rounded-sm"></div>
                CorpPOS
            </div>

            <div class="hidden md:flex gap-8 font-semibold text-slate-600 text-sm">
                <a href="#corporate-features" class="hover:text-blue-900 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    Solutions
                </a>
                <a href="#corporate-pricing" class="hover:text-blue-900 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                    Pricing
                </a>
                <a href="#corporate-testimonials" class="hover:text-blue-900 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    Customers
                </a>
                <a href="#corporate-faq" class="hover:text-blue-900 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
                    Resources
                </a>
            </div>

            <div class="flex gap-4">
                 <button class="text-sm font-bold text-slate-600 hover:text-blue-900">
                    Log In
                </button>
                <button class="bg-blue-900 text-white px-6 py-2 rounded text-sm font-bold hover:bg-blue-800 transition-colors">
                    Get Started
                </button>
            </div>
        </div>
    </nav>

    <CorporateHero />
    <CorporateComponents />

    <footer class="bg-slate-50 py-12 text-center text-slate-500 text-sm border-t border-slate-200">
        <p>&copy; 2024 Corporate POS Systems Inc. All rights reserved.</p>
    </footer>
</div>

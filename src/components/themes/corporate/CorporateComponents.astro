---
import { content } from '../../../data/content';

const { features, pricing, painPoints, solutions, socialProof, faq, finalCta } = content;
---

<!-- Pain & Solutions -->
<section class="py-24 bg-white font-theme border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16">
        <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-8 pb-4 border-b-4 border-red-600 w-fit">Operational Risks</h2>
            <ul class="space-y-6">
                {painPoints.map((pain) => (
                    <li class="flex gap-4 items-start">
                        <div class="w-6 h-6 rounded bg-red-100 flex items-center justify-center text-red-600 shrink-0 mt-1">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                        </div>
                        <p class="text-slate-700 font-medium">{pain}</p>
                    </li>
                ))}
            </ul>
        </div>
        <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-8 pb-4 border-b-4 border-blue-900 w-fit">Strategic Solutions</h2>
            <ul class="space-y-6">
                {solutions.map((sol) => (
                    <li class="flex gap-4 items-start">
                         <div class="w-6 h-6 rounded bg-blue-100 flex items-center justify-center text-blue-900 shrink-0 mt-1">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
                        </div>
                        <p class="text-slate-700 font-medium">{sol}</p>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>

<!-- Features -->
<section id="corporate-features" class="py-24 bg-slate-50 font-theme">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-bold text-slate-900 mb-4">Core Competencies</h2>
            <p class="text-slate-500 max-w-2xl mx-auto">Comprehensive tools designed for enterprise scalability and reliability.</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            {features.map((feature, i) => (
                <div class="bg-white p-8 rounded border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-blue-900 rounded flex items-center justify-center text-white text-2xl mb-6">
                        <svg viewBox="0 0 24 24" class="w-6 h-6" set:html={feature.icon}></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-4">{feature.title}</h3>
                    <p class="text-slate-600 leading-relaxed">{feature.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Pricing -->
<section id="corporate-pricing" class="py-24 bg-white font-theme border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-bold text-slate-900">Subscription Plans</h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 items-start">
            {pricing.plans.map(plan => (
                <div class={`p-8 rounded border ${
                    plan.recommended 
                    ? 'border-blue-900 bg-slate-50 shadow-xl relative' 
                    : 'border-slate-200 bg-white'
                }`}>
                    {plan.recommended && (
                        <div class="absolute top-0 inset-x-0 h-2 bg-blue-900 rounded-t"></div>
                    )}
                    
                    <h3 class="text-xl font-bold text-slate-900 mb-2">{plan.name}</h3>
                    <p class="text-slate-500 text-sm mb-6">{plan.description}</p>
                    
                    <div class="text-4xl font-bold text-slate-900 mb-8">{plan.price}</div>
                    
                    <ul class="space-y-4 mb-8">
                        {plan.features.map(feature => (
                            <li class="flex gap-3 text-slate-700 text-sm">
                                <svg class="w-5 h-5 text-blue-900 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-3 rounded font-bold text-sm transition-colors ${
                        plan.recommended 
                        ? 'bg-blue-900 text-white hover:bg-blue-800' 
                        : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Testimonials -->
<section id="corporate-testimonials" class="py-24 bg-slate-900 text-white font-theme">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400 mb-12 border-b border-slate-800 pb-4">Client Success Stories</h2>
        <div class="grid md:grid-cols-3 gap-8">
            {socialProof.testimonials.map(t => (
                <div>
                    <div class="mb-6 flex text-yellow-500">★★★★★</div>
                    <p class="text-slate-300 text-lg leading-relaxed mb-6 italic">"{t.quote}"</p>
                    <div>
                        <p class="font-bold text-white">{t.name}</p>
                        <p class="text-slate-500 text-sm">Verified Partner</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- FAQ & Footer -->
<section id="corporate-faq" class="py-24 bg-slate-50 font-theme">
    <div class="max-w-3xl mx-auto px-6 mb-24">
        <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
            {faq.map(item => (
                <details class="bg-white border border-slate-200 rounded group">
                    <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold text-slate-900 hover:bg-slate-50 transition-colors">
                        <span>{item.q}</span>
                        <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                    </summary>
                    <div class="p-6 pt-0 text-slate-600 leading-relaxed border-t border-transparent group-open:border-slate-100">
                        {item.a}
                    </div>
                </details>
            ))}
        </div>
    </div>

    <div class="bg-blue-900 py-20 text-center">
        <div class="max-w-4xl mx-auto px-6">
            <h2 class="text-3xl font-bold text-white mb-8">{finalCta.title}</h2>
            <p class="text-blue-200 mb-8 max-w-2xl mx-auto">{finalCta.subtitle}</p>
            <div class="flex flex-col md:flex-row gap-4 justify-center max-w-md mx-auto">
                <input type="email" placeholder="Business Email" class="px-6 py-3 rounded text-slate-900 w-full" />
                <button class="px-8 py-3 bg-red-600 text-white font-bold rounded hover:bg-red-700 transition-colors whitespace-nowrap">
                    {finalCta.primaryCta}
                </button>
            </div>
            <p class="text-blue-300/60 text-xs mt-6">By signing up, you agree to our Terms of Service and Privacy Policy.</p>
        </div>
    </div>
</section>

---
---
<div class="relative w-full h-full flex items-center justify-center pointer-events-none select-none" aria-label="Animation showing chat messages converting to orders">
    
    <!-- Background Grid (Hidden on Mobile) -->
    <div class="hidden md:block absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:40px_40px]"></div>

    <!-- Container for Animation -->
    <div class="relative w-full max-w-lg h-full p-8 flex items-center justify-between gap-8 transform scale-[0.5] sm:scale-[0.75] md:scale-100 origin-center">
        
        <!-- Left Side: Channels -->
        <div class="flex flex-col gap-24 relative z-10">
            <!-- Facebook Channel -->
            <div class="relative group">
                <div class="w-16 h-16 bg-white rounded-2xl shadow-lg border border-blue-100 flex items-center justify-center relative z-20">
                    <svg class="w-8 h-8 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </div>
                <!-- Pulse Effect -->
                <div class="absolute inset-0 bg-blue-500/20 rounded-2xl animate-ping-slow"></div>
                <!-- Label -->
                <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs font-bold text-slate-400 whitespace-nowrap">Facebook</div>
            </div>

            <!-- WhatsApp Channel -->
            <div class="relative group">
                <div class="w-16 h-16 bg-white rounded-2xl shadow-lg border border-green-100 flex items-center justify-center relative z-20">
                    <svg class="w-8 h-8 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.008-.57-.008-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div class="absolute inset-0 bg-green-500/20 rounded-2xl animate-ping-slow delay-700"></div>
                <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs font-bold text-slate-400 whitespace-nowrap">WhatsApp</div>
            </div>
        </div>

        <!-- Animated Messages (Floating Elements) - Hidden on Mobile -->
        <div class="hidden md:block absolute inset-0 overflow-visible pointer-events-none">
            <!-- FB Message Animation -->
            <div class="absolute top-[88px] left-[70px] animate-message-flow opacity-0 bg-white rounded-lg shadow-md p-2 flex items-center gap-2 border border-blue-100 z-30 w-32">
                <div class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-xs">👤</div>
                <div class="h-2 w-16 bg-slate-100 rounded"></div>
            </div>
             <!-- WA Message Animation (Delayed) -->
            <div class="absolute top-[265px] left-[70px] animate-message-flow-delayed opacity-0 bg-white rounded-lg shadow-md p-2 flex items-center gap-2 border border-green-100 z-30 w-32">
                <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-xs">👤</div>
                <div class="h-2 w-16 bg-slate-100 rounded"></div>
            </div>
        </div>

        <!-- Right Side: POS System -->
        <div class="relative z-20 w-64 bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col h-[320px]">
            <!-- POS Header -->
            <div class="h-10 bg-slate-900 flex items-center px-4 gap-2">
                <div class="w-2 h-2 rounded-full bg-red-500"></div>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
                <div class="ml-auto text-[10px] text-slate-400 font-mono">POS_V3</div>
            </div>
            
            <!-- POS Body (Order List) -->
            <div class="flex-1 p-4 space-y-3 bg-slate-50 relative overflow-hidden">
                <!-- Static Orders -->
                <div class="bg-white p-3 rounded shadow-sm border border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                        <div class="space-y-1">
                            <div class="w-16 h-2 bg-slate-200 rounded"></div>
                            <div class="w-10 h-1.5 bg-slate-100 rounded"></div>
                        </div>
                    </div>
                    <div class="w-8 h-4 bg-blue-50 rounded text-[10px] text-blue-600 flex items-center justify-center font-bold">New</div>
                </div>

                <!-- Animated Incoming Order 1 (Matches FB) -->
                <div class="bg-white p-3 rounded shadow-sm border border-slate-100 flex items-center justify-between animate-order-appear opacity-0">
                    <div class="flex items-center gap-2">
                         <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                        <div class="space-y-1">
                             <div class="w-20 h-2 bg-slate-200 rounded"></div>
                             <div class="w-12 h-1.5 bg-slate-100 rounded"></div>
                        </div>
                    </div>
                    <div class="w-8 h-4 bg-blue-50 rounded text-[10px] text-blue-600 flex items-center justify-center font-bold">New</div>
                </div>

                 <!-- Animated Incoming Order 2 (Matches WA) -->
                 <div class="bg-white p-3 rounded shadow-sm border border-slate-100 flex items-center justify-between animate-order-appear-delayed opacity-0">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-green-500"></div>
                        <div class="space-y-1">
                             <div class="w-16 h-2 bg-slate-200 rounded"></div>
                             <div class="w-10 h-1.5 bg-slate-100 rounded"></div>
                        </div>
                    </div>
                    <div class="w-8 h-4 bg-green-50 rounded text-[10px] text-green-600 flex items-center justify-center font-bold">Paid</div>
                </div>
            </div>

            <!-- POS Footer -->
            <div class="h-10 border-t border-slate-200 flex items-center justify-between px-4 bg-white">
                <div class="w-16 h-2 bg-slate-200 rounded"></div>
                <div class="w-8 h-2 bg-slate-200 rounded"></div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Pulse Background for Icons */
    .animate-ping-slow {
        animation: ping 3s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    /* Message Flow Animation */
    @keyframes messageFlow {
        0% { transform: scale(0.5); opacity: 0; }
        10% { transform: scale(1) translateX(0); opacity: 1; }
        60% { transform: translateX(180px) scale(0.8); opacity: 1; }
        80% { transform: translateX(200px) scale(0.5); opacity: 0; }
        100% { transform: translateX(200px) scale(0); opacity: 0; }
    }

    .animate-message-flow {
        animation: messageFlow 4s ease-in-out infinite;
    }
    .animate-message-flow-delayed {
        animation: messageFlow 4s ease-in-out infinite;
        animation-delay: 2s;
    }

    /* Order Appearance Animation */
    @keyframes orderAppear {
        0%, 60% { transform: translateY(10px); opacity: 0; height: 0; padding: 0; margin: 0; }
        70% { transform: translateY(0); opacity: 1; height: auto; padding: 0.75rem; margin-bottom: 0.75rem; }
        90% { opacity: 1; }
        100% { opacity: 0; } /* Loop reset effect for visual flow */
    }

    .animate-order-appear {
        animation: orderAppear 4s ease-in-out infinite;
    }
    .animate-order-appear-delayed {
        animation: orderAppear 4s ease-in-out infinite;
        animation-delay: 2s;
    }

    /* Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
        .animate-message-flow, .animate-message-flow-delayed,
        .animate-order-appear, .animate-order-appear-delayed, 
        .animate-ping-slow {
            animation: none;
            opacity: 1;
            transform: none;
            transition: none;
        }
        /* Show static state for Accessibility */
        .animate-message-flow {
            left: 50%;
            top: 30%;
            opacity: 1;
        }
        .animate-order-appear {
            opacity: 1;
        }
    }
</style>

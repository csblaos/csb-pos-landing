---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';

const { hero } = content;
---

<section id="darkops-hero" class="relative min-h-[90vh] flex items-center pt-20 bg-slate-900 overflow-hidden border-b border-slate-800">
    <!-- Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none opacity-20"></div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
            <div class="inline-flex items-center gap-2 px-2 py-1 bg-emerald-500/10 border border-emerald-500/20 rounded text-emerald-400 font-mono text-xs">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                SYSTEM_ONLINE
            </div>

            <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight leading-none font-mono">
                {hero.title_part1} <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-blue-500">{hero.title_part2}</span>
            </h1>

            <p class="text-lg text-slate-400 max-w-lg leading-relaxed border-l-2 border-slate-700 pl-6 font-mono">
                {hero.subtitle}
            </p>

            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <button class="px-8 py-3 bg-emerald-600 text-white font-bold font-mono text-sm uppercase tracking-wider hover:bg-emerald-500 transition-all shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:shadow-[0_0_30px_rgba(16,185,129,0.5)] flex items-center gap-2 group">
                    <span class="text-emerald-300 mr-1 group-hover:translate-x-1 transition-transform">&gt;</span>
                    {hero.primaryCta}
                </button>
                <button class="px-8 py-3 bg-slate-800 text-slate-300 border border-slate-700 font-bold font-mono text-sm uppercase tracking-wider hover:bg-slate-700 hover:text-white transition-all flex items-center gap-2 group">
                    <span class="text-emerald-500/50 group-hover:text-emerald-400 transition-colors">&gt;_</span>
                    {hero.secondaryCta}
                </button>
            </div>
            
            <div class="grid grid-cols-2 gap-8 pt-8 border-t border-slate-800">
                <div>
                   <div class="text-2xl font-bold text-white font-mono">99.9%</div>
                   <div class="text-xs text-slate-500 uppercase tracking-wider">Uptime</div>
                </div>
                <div>
                   <div class="text-2xl font-bold text-white font-mono">24/7</div>
                   <div class="text-xs text-slate-500 uppercase tracking-wider">Support</div>
                </div>
            </div>
        </div>

        <div class="relative hidden lg:block">
            <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500 to-blue-500 rounded-lg blur opacity-20 animate-pulse"></div>
            <div class="relative bg-slate-800 border border-slate-700 rounded-lg p-2 shadow-2xl">
                <div class="bg-slate-900 rounded border border-slate-800 p-6 h-[400px] flex items-center justify-center relative overflow-hidden">
                    <!-- Fake Dashboard UI -->
                    <div class="absolute top-4 left-6 right-6 h-8 bg-slate-800 rounded flex items-center px-4 gap-2">
                         <div class="w-3 h-3 rounded-full bg-red-500"></div>
                         <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                         <div class="w-3 h-3 rounded-full bg-green-500"></div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 w-full mt-12">
                        <div class="bg-slate-800/50 p-4 rounded border border-slate-700/50 h-32 animate-pulse"></div>
                        <div class="bg-slate-800/50 p-4 rounded border border-slate-700/50 h-32 animate-pulse delay-75"></div>
                        <div class="col-span-2 bg-slate-800/50 p-4 rounded border border-slate-700/50 h-32 animate-pulse delay-150"></div>
                    </div>

                    <div class="absolute bottom-6 right-6">
                        <HeroToast />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

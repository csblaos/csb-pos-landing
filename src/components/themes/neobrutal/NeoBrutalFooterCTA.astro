---
import { content } from '../../../data/content';

const { finalCta } = content;
---

<section class="py-24 bg-white font-theme border-t-4 border-black text-center">
    <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="text-5xl md:text-8xl font-black text-black mb-6 uppercase leading-[0.8]">
            {finalCta.title}
        </h2>
        <p class="text-2xl text-black font-bold mb-12 bg-[#facc15] inline-block px-4">
            {finalCta.subtitle}
        </p>
        
        <div class="bg-black p-8 border-4 border-black max-w-md mx-auto shadow-[12px_12px_0px_0px_#f472b6]">
            <h3 class="text-white font-black uppercase text-2xl mb-6">Let's Go</h3>
            <form class="space-y-4" onsubmit="event.preventDefault(); alert('SENT!');">
                {finalCta.leadForm.fields.map(field => (
                    <input type="text" placeholder={field} class="w-full bg-white border-4 border-white p-4 text-black placeholder-black font-bold uppercase focus:border-[#facc15] outline-none" />
                ))}
                <button type="submit" class="w-full py-4 bg-[#facc15] text-black font-black uppercase text-xl border-4 border-white hover:bg-white hover:border-[#facc15] transition-all">
                    {finalCta.leadForm.submitLabel} !!!
                </button>
            </form>
        </div>
    </div>
</section>

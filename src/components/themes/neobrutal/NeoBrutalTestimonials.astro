---
import { content } from '../../../data/content';

const { socialProof } = content;
---

<section id="neobrutal-testimonials" class="py-24 bg-[#0a0a0a] font-theme border-t-4 border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-black text-center text-[#facc15] mb-16 uppercase italic">
            "They Said What?"
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8">
            {socialProof.testimonials.map(t => (
                <div class="bg-white border-4 border-white p-8 relative hover:bg-[#facc15] transition-colors">
                    <div class="text-6xl font-black text-black absolute -top-6 -left-2 opacity-10">“</div>
                    <p class="text-black font-bold text-xl mb-6 relative z-10">
                        {t.quote}
                    </p>
                    <div class="flex items-center gap-4 pt-4 border-t-4 border-black">
                        <div class="w-12 h-12 bg-black rounded-none flex items-center justify-center text-white font-black text-xl border-2 border-white">
                            {t.name.charAt(0)}
                        </div>
                        <div>
                            <p class="text-black font-black uppercase">{t.name}</p>
                            <p class="text-xs font-bold text-gray-500">VERIFIED HUMAN</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

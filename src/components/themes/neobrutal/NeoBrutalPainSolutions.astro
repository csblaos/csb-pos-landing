---
import { content } from '../../../data/content';

const { painPoints, solutions, comparison } = content;
---

<section class="py-24 bg-white font-theme border-t-4 border-black">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <h2 class="text-4xl md:text-6xl font-black text-center text-black mb-20 uppercase">
            Don't Be <span class="underline decoration-wavy decoration-[#facc15] decoration-4">Stupid</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-0 border-4 border-black shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] mb-32">
            <!-- Pain -->
            <div class="bg-black p-12 text-white">
                <h3 class="text-3xl font-black uppercase mb-8 text-red-500">The Problem</h3>
                <ul class="space-y-6">
                    {painPoints.map((pain, i) => (
                        <li class="flex items-start gap-4 font-bold text-lg">
                            <span class="text-red-500 text-2xl">⚠</span>
                            {pain}
                        </li>
                    ))}
                </ul>
            </div>
            
            <!-- Solution -->
            <div class="bg-[#facc15] p-12 text-black border-l-4 border-black lg:border-l-4 border-t-4 md:border-t-0">
                <h3 class="text-3xl font-black uppercase mb-8">The Fix</h3>
                <ul class="space-y-6">
                    {solutions.map((sol, i) => (
                        <li class="flex items-start gap-4 font-bold text-lg">
                            <span class="bg-black text-white w-8 h-8 flex items-center justify-center rounded-full text-xl">✓</span>
                            {sol}
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <!-- Comparison VS -->
        <div class="max-w-4xl mx-auto">
            <h3 class="text-3xl font-black text-center mb-8 uppercase bg-black text-white inline-block px-4 py-2 transform -rotate-1">
                {comparison.title}
            </h3>
            
            <div class="flex flex-col md:flex-row gap-8">
                <div class="flex-1 bg-gray-100 border-4 border-gray-300 p-8 grayscale">
                    <h4 class="font-black text-xl mb-4 text-gray-500">{comparison.oldWay.title}</h4>
                    <ul class="font-bold text-gray-400 space-y-2">
                        {comparison.oldWay.points.map(p => <li>- {p}</li>)}
                    </ul>
                </div>
                
                <div class="flex-1 bg-[#dbeafe] border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
                    <h4 class="font-black text-xl mb-4">{comparison.newWay.title}</h4>
                    <ul class="font-bold space-y-2">
                         {comparison.newWay.points.map(p => <li>+ {p}</li>)}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

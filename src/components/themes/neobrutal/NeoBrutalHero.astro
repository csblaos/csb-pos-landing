---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';
import ConnectivityAnim from '../../ConnectivityAnim.astro';

const { hero } = content;
---

<section class="min-h-[90vh] flex items-center bg-[#facc15] font-theme relative overflow-hidden py-24 selection:bg-black selection:text-[#facc15]">
    
    <!-- Brutal Pattern -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(black 2px, transparent 2px); background-size: 24px 24px;"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            
            <!-- Content -->
            <div class="order-2 lg:order-1 space-y-8">
                <div class="inline-block px-4 py-2 bg-white border-4 border-black font-bold uppercase tracking-widest text-sm shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transform -rotate-1">
                    ★ {hero.badge}
                </div>
                
                <h1 class="text-5xl lg:text-7xl font-black text-black leading-[0.9] tracking-tighter uppercase">
                    {hero.title}
                </h1>

                <p class="text-xl text-black font-bold leading-relaxed max-w-lg border-l-8 border-black pl-6">
                    {hero.subtitle}
                </p>

                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <button class="px-8 py-4 bg-black text-white font-black uppercase text-lg border-4 border-black shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] hover:translate-x-1 hover:translate-y-1 transition-all">
                        {hero.primaryCta}
                    </button>
                    <button class="px-8 py-4 bg-white text-black font-black uppercase text-lg border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 transition-all hover:bg-[#f472b6]">
                        {hero.secondaryCta}
                    </button>
                </div>

                 <!-- Tech Specs -->
                 <div class="pt-8 flex flex-wrap gap-4">
                    {hero.highlights.map(item => (
                        <div class="px-3 py-1 bg-black text-[#facc15] font-bold text-sm uppercase transform rotate-2 first:-rotate-1 last:rotate-3">
                            {item}
                        </div>
                    ))}
                 </div>
            </div>

            <!-- Visual: Brutalist Window -->
            <div class="order-1 lg:order-2 relative">
                <div class="bg-white border-4 border-black p-4 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
                    <div class="bg-black text-white p-2 border-b-4 border-black font-mono font-bold flex justify-between items-center mb-4">
                         <span>SYSTEM.EXE</span>
                         <div class="flex gap-2">
                             <div class="w-4 h-4 bg-[#facc15] border-2 border-white"></div>
                             <div class="w-4 h-4 bg-[#f472b6] border-2 border-white"></div>
                             <div class="w-4 h-4 bg-red-500 border-2 border-white"></div>
                         </div>
                    </div>
                    
                    <div class="bg-[#f0f9ff] border-4 border-black h-80 relative overflow-hidden flex items-center justify-center">
                        <div class="w-full max-w-sm">
                            <ConnectivityAnim />
                        </div>
                    </div>

                    <div class="mt-4 flex gap-4 font-mono text-xs font-bold">
                        <div class="flex-1 bg-black text-white p-2 text-center">STATUS: ONLINE</div>
                        <div class="flex-1 border-2 border-black p-2 text-center bg-[#f472b6]">SYNC: TRUE</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Hero Toast: Custom Position/Style needed, but reusing component for logic -->
    <div class="[&>div]:!shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] [&>div]:!border-2 [&>div]:!border-black [&>div]:!bg-white [&>div]:!rounded-none">
        <HeroToast />
    </div>

</section>

---
import { content } from '../../../data/content';

const { pricing } = content;
---

<section id="neobrutal-pricing" class="py-24 bg-[#f472b6] font-theme border-t-4 border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-5xl md:text-7xl font-black text-black mb-4 uppercase stroke-white">PRICE TAGS</h2>
            <p class="text-white font-black text-xl bg-black inline-block px-4 py-1 transform -rotate-1">{pricing.note}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 items-start">
            {pricing.plans.map(plan => (
                <div class={`relative p-8 border-4 border-black transition-all duration-300 ${
                    plan.recommended 
                    ? 'bg-[#facc15] shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] scale-105 z-10' 
                    : 'bg-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]'
                }`}>
                    {plan.recommended && (
                        <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-black text-white text-sm font-black px-6 py-2 uppercase border-4 border-white transform rotate-2">
                            Best Deal
                        </div>
                    )}

                    <h3 class="text-3xl font-black mb-2 uppercase">
                        {plan.name}
                    </h3>
                    <p class="text-sm font-bold mb-8 h-12 border-b-4 border-black pb-4">{plan.description}</p>
                    
                    <div class="mb-8">
                        <span class="text-5xl font-black tracking-tighter">{plan.price}</span>
                    </div>

                    <ul class="space-y-4 mb-8">
                        {plan.features.map(feature => (
                            <li class="flex items-start text-sm font-bold">
                                <span class="mr-3 bg-black text-white w-6 h-6 flex items-center justify-center text-xs">✓</span>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-4 text-lg font-black uppercase border-4 border-black transition-all ${
                        plan.recommended 
                        ? 'bg-black text-white hover:bg-white hover:text-black' 
                        : 'bg-white text-black hover:bg-black hover:text-white'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';
import ConnectivityAnim from '../../ConnectivityAnim.astro';

const { hero } = content;
---

<section class="min-h-screen flex items-center bg-gradient-to-b from-[#f5f3ff] to-white font-theme relative overflow-hidden py-24">
    
    <!-- Blobs -->
    <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-[#c7d2fe] rounded-full blur-3xl opacity-30 animate-pulse"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[600px] h-[600px] bg-[#a7f3d0] rounded-full blur-3xl opacity-30 animate-pulse animation-delay-2000"></div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
        <div class="text-center max-w-4xl mx-auto mb-16">
            <span class="inline-block px-4 py-2 rounded-full bg-white text-[#6366f1] font-bold text-sm shadow-sm mb-6 animate-bounce">
                ✨ {hero.badge}
            </span>
            <h1 class="text-5xl md:text-7xl font-bold text-[#3730a3] mb-6 leading-tight tracking-tight">
                {hero.title}
            </h1>
            <p class="text-xl text-[#6b7280] leading-relaxed mb-8">
                {hero.subtitle}
            </p>
            <div class="flex justify-center gap-4">
                <button class="bg-[#6366f1] text-white px-8 py-4 rounded-full font-bold shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:scale-105 transition-all">
                    {hero.primaryCta}
                </button>
                <button class="bg-white text-[#4b5563] px-8 py-4 rounded-full font-bold shadow hover:bg-gray-50 transition-all">
                    {hero.secondaryCta}
                </button>
            </div>
        </div>

        <!-- Dashboard Visual - Friendly Style -->
        <div class="bg-white rounded-[2rem] shadow-2xl shadow-indigo-200/50 p-4 md:p-8 max-w-5xl mx-auto border border-white relative">
            <div class="flex gap-2 mb-4">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            
            <div class="bg-[#f8fafc] rounded-3xl h-96 w-full flex items-center justify-center relative overflow-hidden p-8">
                <!-- Insert Connectivity Anim but style it a bit softer via wrapper -->
                <div class="w-full max-w-2xl mix-blend-multiply">
                    <ConnectivityAnim />
                </div>
            </div>
        </div>
    </div>

    <!-- Soft Toast -->
    <div class="[&>div]:!shadow-xl [&>div]:!shadow-indigo-100 [&>div]:!rounded-2xl [&>div]:!border-0">
        <HeroToast />
    </div>

</section>

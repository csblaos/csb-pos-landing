---
import FriendlyHero from './FriendlyHero.astro';
import FriendlyComponents from './FriendlyComponents.astro';
---

<div class="font-sans bg-white min-h-screen text-slate-800">
    <nav class="sticky top-4 z-50 max-w-5xl mx-auto px-4">
        <div class="bg-white/80 backdrop-blur-lg rounded-2xl px-6 py-4 flex justify-between items-center shadow-lg shadow-indigo-100 border border-white">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-500 to-purple-500"></div>
                <span class="font-bold text-indigo-900 text-lg">SaaSPOS</span>
            </div>
            
            <div class="hidden md:flex gap-6 font-medium text-gray-500 text-sm">
                <a href="#friendly-features" class="hover:text-indigo-600">Features</a>
                <a href="#friendly-pricing" class="hover:text-indigo-600">Pricing</a>
            </div>

            <button class="bg-indigo-50 text-indigo-600 px-6 py-2 rounded-xl font-bold text-sm hover:bg-indigo-100 transition-colors">
                Sign In
            </button>
        </div>
    </nav>

    <FriendlyHero />
    <FriendlyComponents />

    <footer class="py-12 text-center text-gray-400 text-sm font-medium">
        Made with ❤️ for Sellers
    </footer>
</div>

---
import { content } from '../../../data/content';

const { features } = content;
---

<section id="premium-features" class="py-32 bg-[#fff7ed] font-theme">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid md:grid-cols-2 gap-16 lg:gap-24">
            <div class="md:self-start md:sticky md:top-32 mb-12 md:mb-0">
                <h2 class="text-4xl font-serif text-[#1c1917] mb-8 leading-tight">
                    Excellence in <br/> Every Detail.
                </h2>
                <div class="h-1 w-24 bg-[#ca8a04] mb-8"></div>
                <p class="text-[#57534e] font-light leading-relaxed text-lg">
                    สัมผัสประสบการณ์การจัดการร้านค้าที่เหนือระดับ ฟีเจอร์ที่ถูกออกแบบมาอย่างพิถีพิถันเพื่อธุรกิจของคุณ
                </p>
            </div>

            <div class="space-y-16">
                {features.map((feature, index) => (
                    <div class="group">
                        <div class="flex items-baseline gap-4 mb-3 border-b border-[#e7e5e4] pb-3 group-hover:border-[#ca8a04] transition-colors duration-500">
                            <span class="text-xs font-bold text-[#ca8a04] uppercase tracking-widest">0{index + 1}</span>
                            <h3 class="text-xl font-serif text-[#1c1917]">{feature.title}</h3>
                        </div>
                        <p class="text-[#57534e] font-light pl-8 text-sm leading-relaxed">
                            {feature.description}
                        </p>
                    </div>
                ))}
            </div>
        </div>

    </div>
</section>

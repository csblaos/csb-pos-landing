---
import { content } from '../../../data/content';

const { pricing } = content;
---

<section class="py-16 md:py-32 bg-[#1c1917] text-[#fafaf9] font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 md:mb-24">
            <h2 class="text-3xl font-serif mb-4">Membership Plans</h2>
            <p class="text-[#a8a29e] font-light tracking-wide text-sm uppercase">{pricing.note}</p>
        </div>

        <div class="grid lg:grid-cols-3 gap-0 border border-[#44403c] divide-y lg:divide-y-0 lg:divide-x divide-[#44403c]">
            {pricing.plans.map(plan => (
                <div class={`p-8 md:p-12 flex flex-col items-center text-center transition-colors duration-500 ${plan.recommended ? 'bg-[#292524]' : 'hover:bg-[#292524]'}`}>
                    
                    <h3 class="text-lg font-serif mb-2 text-[#ca8a04]">{plan.name}</h3>
                    <p class="text-xs text-[#a8a29e] mb-10 h-8">{plan.description}</p>
                    
                    <div class="mb-10">
                        <span class="text-4xl font-serif">{plan.price}</span>
                    </div>

                    <ul class="space-y-4 mb-12 flex-1 w-full text-left pl-8">
                        {plan.features.map(feature => (
                            <li class="flex items-center text-sm font-light text-[#d6d3d1]">
                                <span class="w-1 h-1 bg-[#ca8a04] rounded-full mr-4"></span>
                                {feature}
                            </li>
                        ))}
                    </ul>

                    <button class={`w-full py-4 text-xs font-bold uppercase tracking-[0.2em] border transition-all duration-500 ${
                        plan.recommended 
                        ? 'bg-[#ca8a04] border-[#ca8a04] text-[#1c1917] hover:bg-white hover:border-white' 
                        : 'border-[#57534e] text-[#a8a29e] hover:border-white hover:text-white'
                    }`}>
                        {plan.cta}
                    </button>
                </div>
            ))}
        </div>
    </div>
</section>

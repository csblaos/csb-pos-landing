---
import PremiumHero from './PremiumHero.astro';
import PremiumFeatures from './PremiumFeatures.astro';
import PremiumPricing from './PremiumPricing.astro';
import PremiumPainSolutions from './PremiumPainSolutions.astro';
import PremiumFooterCTA from './PremiumFooterCTA.astro';
---

<div class="font-prompt bg-[#fafaf9] min-h-screen text-[#1c1917]">
    <!-- Minimalist Nav -->
    <!-- Premium Nav -->
    <nav class="fixed top-0 w-full z-40 py-6 px-6 md:px-12 flex justify-between items-center border-b border-[#e7e5e4] bg-[#fafaf9]/90 backdrop-blur-md transition-all duration-300">
        <div class="text-xl font-serif font-bold tracking-widest text-[#1c1917] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#ca8a04]"></span>
            SAAS POS.
        </div>

        <!-- Desktop Nav -->
        <div class="hidden md:flex gap-8 text-xs font-bold uppercase tracking-widest text-[#57534e]">
            <a href="#premium-features" class="hover:text-[#ca8a04] transition-colors py-2">Features</a>
            <a href="#premium-pricing" class="hover:text-[#ca8a04] transition-colors py-2">Pricing</a>
            <a href="#premium-faq" class="hover:text-[#ca8a04] transition-colors py-2">FAQ</a>
        </div>

        <div class="flex items-center gap-4">
            <button class="hidden md:block text-xs font-bold uppercase tracking-[0.2em] hover:text-[#ca8a04] transition-colors border border-[#e7e5e4] px-6 py-2 rounded-sm hover:border-[#ca8a04]">
                Client Login
            </button>

            <!-- Mobile Trigger -->
            <button id="premium-menu-btn" class="md:hidden text-[#1c1917] p-2 hover:text-[#ca8a04]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div id="premium-mobile-menu" class="hidden md:hidden absolute top-[85px] left-0 w-full bg-[#fafaf9] border-b border-[#e7e5e4] p-8 flex-col gap-6 shadow-xl">
            <a href="#premium-features" class="text-xl font-serif text-[#1c1917] hover:text-[#ca8a04] hover:pl-2 transition-all">Features</a>
            <a href="#premium-pricing" class="text-xl font-serif text-[#1c1917] hover:text-[#ca8a04] hover:pl-2 transition-all">Pricing</a>
            <a href="#premium-faq" class="text-xl font-serif text-[#1c1917] hover:text-[#ca8a04] hover:pl-2 transition-all">FAQ</a>
            <button class="w-full text-center text-xs font-bold uppercase tracking-[0.2em] bg-[#1c1917] text-[#fafaf9] px-6 py-4 rounded-sm hover:bg-[#ca8a04] transition-colors mt-4">
                Client Login
            </button>
        </div>
    </nav>

    <PremiumHero />
    <PremiumPainSolutions />
    <PremiumFeatures />
    <PremiumPricing />
    <PremiumFooterCTA />

    <footer class="bg-white border-t border-[#e7e5e4] py-16 text-center">
        <div class="text-[#ca8a04] font-serif text-2xl italic mb-4">SaaS POS</div>
        <p class="text-[#a8a29e] text-xs uppercase tracking-widest">© 2024. All Rights Reserved.</p>
    </footer>
</div>

<script>
    const btn = document.getElementById('premium-menu-btn');
    const menu = document.getElementById('premium-mobile-menu');

    btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        menu?.classList.toggle('flex');
    });
</script>

---
import { content } from '../../../data/content';

const { socialProof, faq, finalCta } = content;
---

<section class="py-16 md:py-32 bg-[#1c1917] text-[#fafaf9] font-theme border-t border-[#44403c]">
    
    <!-- Testimonials: Clean Typography -->
    <div class="max-w-4xl mx-auto px-4 mb-16 md:mb-32 text-center">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-[#ca8a04] mb-16">Client Stories</h2>
        <div class="space-y-24">
            {socialProof.testimonials.map(t => (
                <div>
                   <p class="text-2xl md:text-3xl font-serif italic text-[#d6d3d1] leading-relaxed mb-8">"{t.quote}"</p>
                   <p class="text-xs font-bold uppercase tracking-widest text-[#78716c]">{t.name}</p>
                </div>
            ))}
        </div>
    </div>

    <!-- Final CTA: Minimalist Input -->
    <div class="max-w-2xl mx-auto px-4 text-center">
        <div class="w-px h-24 bg-[#ca8a04] mx-auto mb-8"></div>
        <h2 class="text-4xl font-serif mb-6">{finalCta.title}</h2>
        <p class="text-[#a8a29e] font-light mb-12">{finalCta.subtitle}</p>
        
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Request received.');">
            <div class="grid gap-6">
                {finalCta.leadForm.fields.map(field => (
                    <input type="text" placeholder={field} aria-label={field} class="bg-transparent border-b border-[#57534e] py-4 text-center text-[#fafaf9] placeholder-[#57534e] focus:border-[#ca8a04] outline-none transition-colors" />
                ))}
            </div>
            <button type="submit" class="mt-12 px-12 py-4 border border-[#ca8a04] text-[#ca8a04] hover:bg-[#ca8a04] hover:text-[#1c1917] transition-all duration-500 uppercase tracking-widest text-xs font-bold">
                {finalCta.leadForm.submitLabel}
            </button>
        </form>
    </div>

</section>

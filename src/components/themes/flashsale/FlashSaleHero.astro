---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';

const { hero } = content;
---

<section id="flashsale-hero" class="relative min-h-screen flex items-center pt-24 bg-[#fff1f2] overflow-hidden border-b-8 border-yellow-400">
    <!-- Urgency Background -->
    <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,#fff1f2,#fff1f2_10px,#ffe4e6_10px,#ffe4e6_20px)] opacity-50"></div>
    
    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 text-center">
        <!-- Floating Elements -->
         <div class="absolute top-10 left-10 rotate-[-12deg] bg-yellow-400 text-red-900 font-black text-xl px-4 py-2 shadow-lg animate-bounce hidden lg:block">
            LIMITED TIME OFFER!
        </div>
        <div class="absolute bottom-20 right-10 rotate-[12deg] bg-red-600 text-white font-black text-xl px-4 py-2 shadow-lg animate-pulse hidden lg:block">
            -20% OFF TODAY
        </div>

        <div class="max-w-4xl mx-auto space-y-8">
            <div class="inline-block bg-red-600 text-white font-black uppercase tracking-widest text-sm px-4 py-1 skew-x-[-12deg]">
                <span class="inline-block skew-x-[12deg]">Flash Sale Ends Soon</span>
            </div>

            <h1 class="text-6xl md:text-8xl font-black text-red-900 uppercase italic leading-[0.9] drop-shadow-sm">
                {hero.title_part1} <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-yellow-500">{hero.title_part2}</span>
            </h1>

            <p class="text-2xl text-red-800/80 font-bold uppercase max-w-2xl mx-auto">
                {hero.subtitle}
            </p>

            <!-- Counter -->
            <div class="flex justify-center gap-4 text-center font-mono py-8">
                <div class="bg-red-900 text-yellow-400 p-4 rounded-lg w-24 border-b-4 border-red-950">
                    <span class="text-4xl font-black block">02</span>
                    <span class="text-xs uppercase">Hours</span>
                </div>
                <div class="bg-red-900 text-yellow-400 p-4 rounded-lg w-24 border-b-4 border-red-950">
                    <span class="text-4xl font-black block">45</span>
                    <span class="text-xs uppercase">Mins</span>
                </div>
                 <div class="bg-red-900 text-yellow-400 p-4 rounded-lg w-24 border-b-4 border-red-950">
                    <span class="text-4xl font-black block">12</span>
                    <span class="text-xs uppercase">Secs</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                <button class="px-10 py-5 bg-yellow-400 text-red-900 font-black text-xl uppercase tracking-wider skew-x-[-12deg] hover:bg-yellow-300 hover:scale-110 transition-transform shadow-[0_10px_0_rgb(185,28,28)] active:shadow-none active:translate-y-[10px] flex items-center justify-center gap-2 group">
                    <svg class="w-6 h-6 animate-pulse" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    <span class="inline-block skew-x-[12deg]">{hero.primaryCta} NOW</span>
                </button>
                <button class="px-10 py-5 bg-white border-4 border-red-900 text-red-900 font-black text-xl uppercase tracking-wider skew-x-[-12deg] hover:bg-red-50 transition-colors flex items-center justify-center gap-2">
                     <span class="inline-block skew-x-[12deg]">{hero.secondaryCta}</span>
                     <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="absolute bottom-12 right-6">
        <HeroToast />
    </div>
</section>

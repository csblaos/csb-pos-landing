---
import { content } from '../../../data/content';

const { features } = content;
---

<section id="web3-features" class="py-24 bg-[#050505] font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-5xl font-bold text-center text-white mb-16 font-mono">
            Core_Modules
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {features.map((feature, index) => (
                <div class="group relative p-1 rounded-2xl bg-gradient-to-b from-slate-800 to-slate-900 hover:from-cyan-600 hover:to-green-600 transition-all duration-500">
                    <div class="bg-[#0a0a0a] rounded-xl p-8 h-full relative z-10 overflow-hidden">
                        <!-- Abstract Tech shape -->
                        <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-slate-800/20 to-transparent rounded-bl-3xl -mr-4 -mt-4 group-hover:from-cyan-500/10 transition-colors"></div>

                        <div class="w-12 h-12 bg-slate-900 border border-slate-700 rounded-lg flex items-center justify-center text-2xl mb-6 shadow-inner group-hover:border-cyan-500 group-hover:text-cyan-400 group-hover:shadow-[0_0_15px_rgba(6,182,212,0.2)] transition-all">
                            <svg viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor" set:html={feature.icon}></svg>
                        </div>

                        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-400 transition-colors font-mono">
                            {feature.title}
                        </h3>
                        
                        <p class="text-slate-400 text-sm leading-relaxed group-hover:text-slate-300">
                            {feature.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

---
import Web3Hero from './Web3Hero.astro';
import Web3PainSolutions from './Web3PainSolutions.astro';
import Web3Features from './Web3Features.astro';
import Web3Pricing from './Web3Pricing.astro';
import Web3Testimonials from './Web3Testimonials.astro';
import Web3FAQ from './Web3FAQ.astro';
import Web3FooterCTA from './Web3FooterCTA.astro';
---

<div class="font-chakra bg-[#050505] min-h-screen text-slate-300 selection:bg-cyan-500/30">
    <!-- Headers -->
    <!-- Headers -->
    <nav class="fixed top-0 w-full z-40 border-b border-white/5 backdrop-blur-md bg-[#050505]/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 md:px-8 h-20 flex justify-between items-center">
            <!-- Logo -->
            <div class="text-xl font-bold tracking-widest text-white font-mono flex items-center gap-2">
                <span class="w-3 h-3 bg-cyan-500 rounded-full animate-pulse shadow-[0_0_10px_cyan]"></span>
                POS_SYSTEM_V3.0
            </div>

            <!-- Desktop Nav -->
            <div class="hidden md:flex gap-8 text-xs font-bold uppercase tracking-widest text-slate-400">
                <a href="#web3-features" class="hover:text-cyan-400 transition-colors py-2">[Features]</a>
                <a href="#web3-pricing" class="hover:text-cyan-400 transition-colors py-2">[Access]</a>
                <a href="#web3-testimonials" class="hover:text-cyan-400 transition-colors py-2">[Logs]</a>
                <a href="#web3-faq" class="hover:text-cyan-400 transition-colors py-2">[Inquiries]</a>
            </div>

            <!-- CTA & Mobile Toggle -->
            <div class="flex items-center gap-4">
                <button class="hidden md:block text-xs font-bold uppercase tracking-[0.2em] border border-cyan-900/50 px-4 py-2 rounded text-cyan-500 hover:bg-cyan-950 hover:text-cyan-400 transition-colors shadow-[0_0_15px_rgba(6,182,212,0.1)] hover:shadow-[0_0_25px_rgba(6,182,212,0.2)]">
                    Node_Login
                </button>

                <!-- Mobile Trigger -->
                <button id="web3-menu-btn" class="md:hidden text-cyan-500 p-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu (Hidden) -->
        <div id="web3-mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-[#050505] border-b border-white/10 p-4 flex-col gap-4 shadow-2xl">
            <a href="#web3-features" class="block text-slate-400 hover:text-cyan-400 font-mono text-sm uppercase p-2 border-l-2 border-transparent hover:border-cyan-500 bg-slate-900/0 hover:bg-slate-900/50">>> Features</a>
            <a href="#web3-pricing" class="block text-slate-400 hover:text-cyan-400 font-mono text-sm uppercase p-2 border-l-2 border-transparent hover:border-cyan-500 bg-slate-900/0 hover:bg-slate-900/50">>> Pricing</a>
            <a href="#web3-testimonials" class="block text-slate-400 hover:text-cyan-400 font-mono text-sm uppercase p-2 border-l-2 border-transparent hover:border-cyan-500 bg-slate-900/0 hover:bg-slate-900/50">>> Logs</a>
            <button class="w-full text-center text-xs font-bold uppercase tracking-[0.2em] border border-cyan-900/50 px-4 py-3 rounded text-cyan-500 hover:bg-cyan-950/50 mt-2">
                Node_Login
            </button>
        </div>
    </nav>

    <Web3Hero />
    <Web3PainSolutions />
    <Web3Features />
    <Web3Pricing />
    <Web3Testimonials />
    <Web3FAQ />
    <Web3FooterCTA />

    <footer class="bg-black border-t border-slate-900 py-12 text-center">
        <div class="text-slate-600 text-xs font-mono uppercase tracking-widest">
            © 2024. All Systems Operational.
        </div>
    </footer>
</div>

<script>
    const btn = document.getElementById('web3-menu-btn');
    const menu = document.getElementById('web3-mobile-menu');

    btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        menu?.classList.toggle('flex');
    });
</script>

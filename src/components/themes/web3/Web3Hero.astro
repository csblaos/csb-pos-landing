---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';
import ConnectivityAnim from '../../ConnectivityAnim.astro';

const { hero } = content;
---

<section class="min-h-[90vh] lg:min-h-screen flex items-center bg-[#050505] font-theme relative overflow-hidden py-24 lg:py-0 selection:bg-cyan-500/30 selection:text-cyan-200">
    
    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_110%)] opacity-20 pointer-events-none"></div>
    
    <!-- Glow Effects -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-cyan-500/20 rounded-full blur-[128px] pointer-events-none mix-blend-screen animate-pulse-slow"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-[128px] pointer-events-none mix-blend-screen animate-pulse-slow animation-delay-2000"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            
            <!-- Content: Tech/Glitch Typography -->
            <div class="order-2 lg:order-1 space-y-8 lg:space-y-10 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded border border-cyan-500/30 bg-cyan-950/30 backdrop-blur-sm text-cyan-400 font-theme tracking-widest text-xs uppercase shadow-[0_0_15px_rgba(6,182,212,0.1)]">
                    <span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>
                    {hero.badge}
                </div>
                
                <h1 class="text-4xl lg:text-7xl font-bold text-white leading-tight tranking-tight">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-white to-green-400 animate-gradient-text bg-300%">{hero.title}</span>
                </h1>

                <p class="text-lg lg:text-xl text-slate-400 font-light leading-relaxed max-w-lg mx-auto lg:mx-0 font-mono">
                    > {hero.subtitle}_
                </p>

                <div class="flex flex-col sm:flex-row gap-4 lg:gap-6 pt-4 justify-center lg:justify-start">
                    <button class="group relative px-8 py-4 bg-cyan-600 text-white font-bold uppercase tracking-widest overflow-hidden rounded clip-path-polygon hover:bg-cyan-500 transition-all duration-300 w-full sm:w-auto shadow-[0_0_20px_rgba(6,182,212,0.4)] hover:shadow-[0_0_40px_rgba(6,182,212,0.6)]">
                        <span class="relative z-10">{hero.primaryCta}</span>
                        <div class="absolute inset-0 h-full w-full scale-0 rounded transition-all duration-300 group-hover:scale-100 group-hover:bg-cyan-400/20"></div>
                    </button>
                    <button class="px-8 py-4 border border-slate-700 text-slate-300 font-bold uppercase tracking-widest hover:border-green-500 hover:text-green-400 hover:shadow-[0_0_15px_rgba(34,197,94,0.2)] transition-all duration-300 w-full sm:w-auto bg-slate-900/50 backdrop-blur">
                        {hero.secondaryCta}
                    </button>
                </div>

                 <!-- Tech Specs -->
                 <div class="pt-8 border-t border-slate-800 flex flex-wrap justify-center lg:justify-start gap-8 opacity-70">
                    {hero.highlights.slice(0, 3).map(item => (
                        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-cyan-500/80 font-mono">
                            <span class="text-lg">❖</span> {item}
                        </div>
                    ))}
                 </div>
            </div>

            <!-- Visual: Holographic Dashboard -->
            <div class="order-1 lg:order-2 relative perspective-1000 group">
                <div class="relative z-10 transform transition-transform duration-700 group-hover:rotate-y-6 group-hover:rotate-x-6">
                    <!-- Glass Panel -->
                    <div class="bg-slate-900/40 backdrop-blur-xl border border-slate-700/50 p-1 rounded-2xl shadow-[0_0_50px_rgba(6,182,212,0.15)] relative overflow-hidden">
                         <!-- Scanline Overlay -->
                         <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-20 bg-[length:100%_2px,3px_100%] pointer-events-none opacity-20"></div>

                         <!-- Content Container -->
                         <div class="bg-[#0a0a0a] rounded-xl overflow-hidden relative min-h-[400px]">
                             <!-- Header -->
                             <div class="h-10 bg-slate-900/80 border-b border-slate-800 flex items-center px-4 justify-between">
                                 <div class="flex gap-2">
                                     <div class="w-2 h-2 rounded-full bg-slate-600"></div>
                                     <div class="w-2 h-2 rounded-full bg-slate-600"></div>
                                 </div>
                                 <div class="text-[10px] text-slate-500 font-mono">SYSTEM_ONLINE</div>
                             </div>

                             <!-- Data Viz -->
                             <div class="p-6 space-y-6">
                                 <div class="flex justify-between items-end">
                                     <div>
                                         <div class="text-slate-500 text-[10px] uppercase font-mono mb-1">Total_Vol_24h</div>
                                         <div class="text-3xl text-white font-bold font-mono tracking-tighter">
                                             <span class="text-cyan-500">$</span> 12,450.00
                                         </div>
                                     </div>
                                     <div class="text-green-500 text-xs font-mono bg-green-500/10 px-2 py-1 rounded border border-green-500/20">
                                         ▲ 12.5%
                                     </div>
                                 </div>

                                 <!-- Dynamic Area -->
                                 <div class="relative h-48 border border-slate-800 bg-slate-900/30 rounded-lg overflow-hidden">
                                     <!-- Grid Lines -->
                                     <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:1rem_1rem] opacity-20"></div>
                                     
                                     <!-- Connectivity Animation Wrapper -->
                                     <div class="absolute inset-0 flex items-center justify-center">
                                         <div class="w-full h-full scale-90">
                                            <ConnectivityAnim />
                                         </div>
                                     </div>
                                 </div>

                                 <!-- Terminal Output -->
                                 <div class="font-mono text-[10px] text-green-500/80 space-y-1">
                                     <div class="flex gap-2"><span class="text-slate-600">>></span> Initializing connection... [OK]</div>
                                     <div class="flex gap-2"><span class="text-slate-600">>></span> Syncing orders from Facebook... [OK]</div>
                                     <div class="flex gap-2"><span class="text-slate-600">>></span> Syncing orders from WhatsApp... [OK]</div>
                                 </div>
                             </div>
                         </div>
                    </div>
                </div>

                <!-- Floating Elements -->
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-cyan-500/30 blur-3xl animate-pulse-slow"></div>
            </div>

        </div>
    </div>
    
    <!-- Hero Toast -->
    <HeroToast />

</section>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
    .clip-path-polygon {
        clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
    }
    .animate-gradient-text {
        background-size: 300%;
        animation: gradient-pan 8s ease infinite;
    }
    .bg-300% {
        background-size: 300%;
    }
    @keyframes gradient-pan {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
</style>

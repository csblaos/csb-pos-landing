---
import { content } from '../../../data/content';

const { finalCta } = content;
---

<section class="py-24 bg-gradient-to-b from-[#050505] to-[#0a0a0a] font-theme text-center relative overflow-hidden">
    <!-- Grid -->
    <div class="absolute inset-0 bg-[linear-gradient(#1e293b_1px,transparent_1px)] bg-[size:2rem_2rem] [mask-image:linear-gradient(to_bottom,transparent,black)] opacity-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="text-4xl md:text-6xl font-bold text-white mb-6 font-mono tracking-tight">
            {finalCta.title}
        </h2>
        <p class="text-xl text-slate-400 mb-12 max-w-2xl mx-auto">
            {finalCta.subtitle}
        </p>
        
        <div class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl backdrop-blur max-w-md mx-auto shadow-[0_0_50px_rgba(6,182,212,0.1)]">
            <h3 class="text-cyan-400 font-mono uppercase tracking-widest text-sm mb-6">Initialize_Setup</h3>
            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Transmission Sent.');">
                {finalCta.leadForm.fields.map(field => (
                    <input type="text" placeholder={field} class="w-full bg-[#050505] border border-slate-700 rounded p-3 text-white placeholder-slate-600 focus:border-cyan-500 focus:shadow-[0_0_15px_rgba(6,182,212,0.3)] outline-none transition-all font-mono text-sm" />
                ))}
                <button type="submit" class="w-full py-4 bg-cyan-600 text-white font-bold uppercase tracking-widest rounded hover:bg-cyan-500 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] transition-all mt-4 clip-path-polygon">
                    {finalCta.leadForm.submitLabel}
                </button>
            </form>
        </div>
    </div>
</section>

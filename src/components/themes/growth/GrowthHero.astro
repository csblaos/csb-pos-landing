---
import { content } from '../../../data/content';
import HeroToast from '../../HeroToast.astro';
import ConnectivityAnim from '../../ConnectivityAnim.astro';

const { hero } = content;
---

<section class="min-h-[85vh] flex items-center bg-white border-b border-theme-border font-theme pt-24 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Text Content -->
      <div class="space-y-8 animate-fade-in-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-medium">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          {hero.badge}
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 leading-tight">
          {hero.title}
        </h1>

        <p class="text-lg text-slate-600 max-w-lg leading-relaxed">
          {hero.subtitle}
        </p>

        <ul class="space-y-3">
          {hero.highlights.map(item => (
            <li class="flex items-center text-slate-600">
              <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <button class="px-8 py-3 bg-blue-600 text-white rounded-lg font-semibold shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all hover:-translate-y-1">
            {hero.primaryCta}
          </button>
          <button class="px-8 py-3 bg-white text-slate-700 border border-slate-200 rounded-lg font-semibold hover:bg-slate-50 transition-colors">
            {hero.secondaryCta}
          </button>
        </div>
      </div>

      <!-- Hero Visual: Standard Dashboard Mockup -->
      <div class="relative lg:ml-10">
        <div class="relative rounded-xl bg-slate-900 shadow-2xl overflow-hidden border border-slate-800 scale-100 hover:scale-[1.02] transition-transform duration-500">
          <!-- Fake Browser Header -->
          <div class="h-8 bg-slate-800 border-b border-slate-700 flex items-center px-4 space-x-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <!-- Dashboard Content -->
          <div class="bg-slate-50 p-3 sm:p-6 min-h-[300px] sm:min-h-[400px] flex">
             <div class="hidden sm:flex w-16 border-r border-slate-200 pr-4 flex-col items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-blue-600"></div>
                <div class="w-8 h-8 rounded bg-slate-200"></div>
                <div class="w-8 h-8 rounded bg-slate-200"></div>
             </div>
             <div class="flex-1 sm:pl-6">
                <div class="flex justify-between items-center mb-8">
                    <div class="h-8 w-32 sm:w-48 bg-slate-200 rounded"></div>
                    <div class="h-8 w-16 sm:w-24 bg-blue-100 rounded"></div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                    <div class="h-24 bg-white rounded shadow-sm border border-slate-100 p-4">
                        <div class="h-4 w-12 bg-slate-100 mb-2"></div>
                        <div class="h-8 w-20 bg-slate-800 rounded"></div>
                    </div>
                    <div class="h-24 bg-white rounded shadow-sm border border-slate-100 p-4">
                        <div class="h-4 w-12 bg-slate-100 mb-2"></div>
                        <div class="h-8 w-20 bg-blue-600 rounded"></div>
                    </div>
                    <div class="h-24 bg-white rounded shadow-sm border border-slate-100 p-4">
                        <div class="h-4 w-12 bg-slate-100 mb-2"></div>
                        <div class="h-8 w-20 bg-green-500 rounded"></div>
                    </div>
                </div>
                <!-- Chat List Mock -->
                <!-- Chat List Mock (Animated) -->
                <div class="h-40">
                    <ConnectivityAnim />
                </div>
             </div>
          </div>
        </div>
        
        <!-- Live Toast Notification -->
        <HeroToast />
      </div>

    </div>
  </div>
</section>

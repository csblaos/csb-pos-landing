---
import { content } from '../../../data/content';

const { faq, finalCta } = content;
---

<section class="py-24 bg-white font-theme border-t border-slate-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">คำถามที่พบบ่อย</h2>
        
        <div class="space-y-6">
            {faq.map((item, index) => (
                <details class="group bg-slate-50 rounded-lg open:ring-2 open:ring-blue-100">
                    <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 text-slate-900">
                        <span>{item.q}</span>
                        <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                        </span>
                    </summary>
                    <div class="text-slate-600 px-6 pb-6">
                        <p>{item.a}</p>
                    </div>
                </details>
            ))}
        </div>
    </div>
</section>

<section class="py-24 bg-blue-600 font-theme text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-4xl font-bold mb-6">{finalCta.title}</h2>
                <p class="text-blue-100 text-lg mb-8">{finalCta.subtitle}</p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <button class="px-8 py-3 bg-white text-blue-600 rounded-lg font-bold hover:bg-blue-50 transition-colors text-center">
                        {finalCta.primaryCta}
                    </button>
                    <button class="px-8 py-3 bg-blue-700 text-white border border-blue-500 rounded-lg font-bold hover:bg-blue-800 transition-colors text-center">
                        {finalCta.secondaryCta}
                    </button>
                </div>
            </div>

            <!-- Lead Form -->
            <div class="bg-white rounded-xl p-8 text-slate-900 shadow-2xl">
                <h3 class="text-xl font-bold mb-6">ปรึกษาทีมงานมืออาชีพ</h3>
                <form class="space-y-4" onsubmit="event.preventDefault(); alert('ขอบคุณที่สนใจ ทีมงานจะติดต่อกลับเร็วๆ นี้ครับ');">
                    {finalCta.leadForm.fields.map(field => (
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">{field}</label>
                            <input type="text" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" required />
                        </div>
                    ))}
                    <button type="submit" class="w-full py-3 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700 transition-colors">
                        {finalCta.leadForm.submitLabel}
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

---
import { content } from '../../../data/content';

const { features } = content;
---

<section class="py-24 bg-slate-50 font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl font-bold text-slate-900 mb-4">ฟีเจอร์ที่ออกแบบมาเพื่อร้านค้าออนไลน์</h2>
            <p class="text-slate-600">ครบทุกเครื่องมือที่คุณต้องการ ในราคาที่จับต้องได้</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {features.map((feature, index) => (
                <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm hover:shadow-lg hover:border-blue-200 transition-all duration-300">
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center mb-6">
                        <span class="text-xl font-bold">{index + 1}</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">{feature.title}</h3>
                    <p class="text-slate-600 leading-relaxed text-sm">
                        {feature.description}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>

---
import { content } from '../../../data/content';

const { painPoints, solutions, comparison } = content;
---

<section class="py-24 bg-white font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Pain Points -->
        <div class="mb-24">
            <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">ปัญหาเดิมๆ ที่ร้านออนไลน์ต้องเจอ</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {painPoints.map((pain, index) => (
                    <div class="bg-red-50 p-6 rounded-lg border border-red-100">
                        <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4 font-bold">
                            !
                        </div>
                        <p class="text-slate-700">{pain}</p>
                    </div>
                ))}
            </div>
        </div>

        <!-- Solutions -->
        <div class="mb-24">
            <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">SaaS POS เข้ามาเปลี่ยนชีวิตคุณ</h2>
            <div class="grid md:grid-cols-2 gap-8">
                {solutions.map((sol, index) => (
                    <div class="flex items-start gap-4">
                        <div class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0 mt-1">
                            ✓
                        </div>
                        <p class="text-slate-700 text-lg">{sol}</p>
                    </div>
                ))}
            </div>
        </div>

        <!-- Comparison Table -->
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
            <h3 class="text-2xl font-bold text-center mb-8">{comparison.title}</h3>
            <div class="grid md:grid-cols-2 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-200">
                
                <!-- Old Way -->
                <div class="space-y-6">
                    <h4 class="text-xl font-bold text-slate-500 text-center">{comparison.oldWay.title}</h4>
                    <ul class="space-y-4">
                        {comparison.oldWay.points.map(point => (
                            <li class="flex items-center text-slate-500">
                                <span class="w-6 h-6 mr-3 text-red-400">✕</span>
                                {point}
                            </li>
                        ))}
                    </ul>
                </div>

                <!-- New Way -->
                <div class="space-y-6 md:pl-8">
                    <h4 class="text-xl font-bold text-blue-600 text-center">{comparison.newWay.title}</h4>
                    <ul class="space-y-4">
                        {comparison.newWay.points.map(point => (
                            <li class="flex items-center text-slate-900 font-medium">
                                <span class="w-6 h-6 mr-3 text-green-500">✓</span>
                                {point}
                            </li>
                        ))}
                    </ul>
                </div>

            </div>
        </div>

    </div>
</section>

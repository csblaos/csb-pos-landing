---
import { content } from '../../../data/content';

const { socialProof } = content;
---

<section class="py-24 bg-slate-50 font-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">เสียงจากผู้ใช้งานจริง</h2>
        
        <!-- Metrics -->
        <div class="grid md:grid-cols-3 gap-8 mb-16">
            {socialProof.metrics.map(metric => (
                <div class="text-center">
                    <div class="text-4xl font-bold text-blue-600 mb-2">{metric.split(' ')[0]}</div> <!-- Simple split for styling -->
                    <p class="text-slate-600">{metric}</p>
                </div>
            ))}
        </div>

        <!-- Quotes -->
        <div class="grid md:grid-cols-3 gap-8">
            {socialProof.testimonials.map(t => (
                <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
                    <div class="flex text-yellow-400 mb-4">
                        {'★★★★★'}
                    </div>
                    <p class="text-slate-600 italic mb-6">"{t.quote}"</p>
                    <div class="font-bold text-slate-900">{t.name}</div>
                </div>
            ))}
        </div>
    </div>
</section>

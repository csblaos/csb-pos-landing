---
import GrowthHero from './GrowthHero.astro';
import GrowthFeatures from './GrowthFeatures.astro';
import GrowthPricing from './GrowthPricing.astro';
import GrowthPainSolutions from './GrowthPainSolutions.astro';
import GrowthTestimonials from './GrowthTestimonials.astro';
import GrowthFooterCTA from './GrowthFooterCTA.astro';
---

<div class="font-prompt bg-white min-h-screen text-slate-900">
    <nav class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="font-bold text-xl text-blue-600 flex items-center gap-2">
                <span class="w-8 h-8 bg-blue-600 text-white rounded flex items-center justify-center">S</span>
                SaaS POS
            </div>
            <div class="hidden md:flex gap-6 text-sm font-medium text-slate-600">
                <a href="#" class="hover:text-blue-600 transition-colors">คุณสมบัติ</a>
                <a href="#" class="hover:text-blue-600 transition-colors">ราคา</a>
                <a href="#" class="hover:text-blue-600 transition-colors">ช่วยเหลือ</a>
            </div>
            <button class="bg-slate-900 text-white px-4 py-2 rounded text-sm font-medium hover:bg-slate-800 transition-colors">
                เข้าสู่ระบบ
            </button>
        </div>
    </nav>

    <GrowthHero />
    <GrowthPainSolutions />
    <GrowthFeatures />
    <GrowthPricing />
    <GrowthTestimonials />
    <GrowthFooterCTA />

    <footer class="bg-slate-900 text-slate-300 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p>&copy; 2024 SaaS POS. All rights reserved.</p>
        </div>
    </footer>
</div>

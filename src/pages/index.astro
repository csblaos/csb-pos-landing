---
import Layout from '../layouts/Layout.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { content } from '../data/content';

// Theme 1: Online Growth
import GrowthAssembly from '../components/themes/growth/GrowthAssembly.astro';

// Theme 2: Social Commerce Boost
import SocialAssembly from '../components/themes/social/SocialAssembly.astro';

// Theme 3: Premium Brand Store
import PremiumAssembly from '../components/themes/premium/PremiumAssembly.astro';
import Web3Assembly from '../components/themes/web3/Web3Assembly.astro';
import NeoBrutalAssembly from '../components/themes/neobrutal/NeoBrutalAssembly.astro';
import EditorialAssembly from '../components/themes/editorial/EditorialAssembly.astro';
import FriendlyAssembly from '../components/themes/friendly/FriendlyAssembly.astro';
import ZenAssembly from '../components/themes/zen/ZenAssembly.astro';
import DarkOpsAssembly from '../components/themes/darkops/DarkOpsAssembly.astro';
import AuroraAssembly from '../components/themes/aurora/AuroraAssembly.astro';
import ClayAssembly from '../components/themes/clay/ClayAssembly.astro';
import HologramAssembly from '../components/themes/hologram/HologramAssembly.astro';
import CorporateAssembly from '../components/themes/corporate/CorporateAssembly.astro';
import FlashSaleAssembly from '../components/themes/flashsale/FlashSaleAssembly.astro';
import MonoAssembly from '../components/themes/mono/MonoAssembly.astro';

const { seo } = content;
---

<Layout title={seo.title}>
    
    <!-- Theme 1: Growth (Default) -->
    <div id="theme-growth" class="theme-content">
        <GrowthAssembly />
    </div>

    <!-- Theme 2: Social -->
    <div id="theme-social" class="theme-content">
        <SocialAssembly />
    </div>

    <!-- Theme 3: Premium -->
    <div id="theme-premium" class="theme-content">
        <PremiumAssembly />
    </div>

    <!-- Theme 4: Web3 -->
    <div id="theme-web3" class="theme-content">
        <Web3Assembly />
    </div>

    <!-- Theme 5: Neo Brutal -->
    <div id="theme-neobrutal" class="theme-content">
        <NeoBrutalAssembly />
    </div>

    <!-- Theme 6: Editorial -->
    <div id="theme-editorial" class="theme-content">
        <EditorialAssembly />
    </div>

    <!-- Theme 7: Friendly -->
    <div id="theme-friendly" class="theme-content">
        <FriendlyAssembly />
    </div>

    <!-- Theme 8: Minimal Zen -->
    <div id="theme-zen" class="theme-content">
        <ZenAssembly />
    </div>

    <!-- Theme 9: Dark Ops Pro -->
    <div id="theme-darkops" class="theme-content">
        <DarkOpsAssembly />
    </div>

    <!-- Theme 10: Aurora Gradient -->
    <div id="theme-aurora" class="theme-content">
        <AuroraAssembly />
    </div>

    <!-- Theme 11: Clay Soft UI -->
    <div id="theme-clay" class="theme-content">
        <ClayAssembly />
    </div>

    <!-- Theme 12: Futuristic Hologram -->
    <div id="theme-hologram" class="theme-content">
        <HologramAssembly />
    </div>

    <!-- Theme 13: Corporate Trust -->
    <div id="theme-corporate" class="theme-content">
        <CorporateAssembly />
    </div>

    <!-- Theme 14: Commerce Flash Sale -->
    <div id="theme-flashsale" class="theme-content">
        <FlashSaleAssembly />
    </div>

    <!-- Theme 15: Mono Premium -->
    <div id="theme-mono" class="theme-content">
        <MonoAssembly />
    </div>

    <!-- Global Theme Switcher -->
    <ThemeSwitcher />

</Layout>
